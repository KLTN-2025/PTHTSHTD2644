@model SmartTable.Models.Restaurants
@{
    ViewBag.Title = "Chi tiết Nhà hàng";
}

@helper DisplayData(string label, object value, bool isLink = false)
{
    string displayValue = value?.ToString() ?? "";

    <div class="flex justify-between border-b border-dashed py-2">
        <dt class="text-sm font-medium text-gray-500">@label</dt>
        <dd class="text-sm font-semibold text-gray-800 text-right max-w-[60%] break-words">
            @if (isLink && !string.IsNullOrEmpty(displayValue))
            {
                <a href="@displayValue" target="_blank" class="text-blue-600 hover:text-blue-800 underline truncate">Xem Link</a>
            }
            else if (value is DateTime dt)
            {
                @dt.ToString("dd/MM/yyyy HH:mm")
            }
            else
            {
                @displayValue
            }
        </dd>
    </div>
}

<h1 class="text-2xl font-bold text-gray-800 mb-6">Chi tiết Nhà hàng: @Model.name</h1>

<div class="bg-white p-6 rounded-lg shadow-xl max-w-6xl mx-auto space-y-8">

    <!-- Thông tin cơ bản -->
    <div class="grid md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-3">
            <h3 class="text-lg font-semibold text-gray-700 border-b pb-2 mb-3">Thông tin cơ bản</h3>

            @DisplayData("ID", Model.restaurant_id)

            <div class="flex justify-between border-b border-dashed py-2">
                <dt class="text-sm font-medium text-gray-500">Chủ sở hữu</dt>
                <dd class="font-semibold text-gray-800 text-right">
                    @(Model.Users != null
                    ? $"{Model.Users.full_name} ({Model.Users.email})"
                    : "Chưa gán")
                </dd>
            </div>

            @DisplayData("Địa chỉ", Model.address)
            @DisplayData("Latitude", Model.latitude)
            @DisplayData("Longitude", Model.longitude)
            @DisplayData("Ngày tạo", Model.created_at)
            <div class="flex justify-between border-b border-dashed py-2">
                <dt class="text-sm font-medium text-gray-500">Trạng thái duyệt</dt>
                <dd class="font-medium @(Model.is_approved.GetValueOrDefault(false) ? "text-green-600" : "text-yellow-600")">
                    @(Model.is_approved.GetValueOrDefault(false) ? "Đã duyệt" : "Chờ duyệt")
                </dd>
            </div>

            @DisplayData("Số bàn tối đa", Model.max_tables)
            @DisplayData("Giờ mở cửa", Model.opening_hours)
            

            <!-- Thông tin liên hệ bổ sung -->
            @DisplayData("Tên người liên hệ", Model.ContactName)
            @DisplayData("Số điện thoại liên hệ", Model.ContactPhone)
            @DisplayData("Vai trò liên hệ", Model.ContactRole)
            @DisplayData("Website", Model.Website, true) 
        </div>

        <div>
            <h3 class="text-lg font-semibold text-gray-700 border-b pb-2 mb-3">Ảnh đại diện</h3>
            <img src="@(string.IsNullOrEmpty(Model.Image) ? "https://via.placeholder.com/300x200.png?text=No+Image" : Model.Image)"
                 alt="Ảnh nhà hàng"
                 class="w-full h-48 object-cover rounded-lg border shadow-sm mb-2" />
            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <a href="@Model.Image" target="_blank" class="text-sm text-blue-600 hover:underline">
                    <i class="fas fa-external-link-alt mr-1"></i> Xem ảnh gốc
                </a>
            }
        </div>
    </div>

    <!-- Dịch vụ & vận hành -->
    <div class="pt-6 border-t space-y-4">
        <h3 class="text-lg font-semibold text-gray-700 border-b pb-2 mb-3">Dịch vụ & Vận hành</h3>
        <div class="grid md:grid-cols-3 gap-6">
            <div class="space-y-2">
                @DisplayData("Phong cách Ẩm thực", Model.CuisineStyle)
                @DisplayData("Loại hình Dịch vụ", Model.ServiceDescription)
                @DisplayData("Kiểu phục vụ", Model.ServiceTypes)
                @DisplayData("Hóa đơn TB/người", Model.AverageBill)
                @DisplayData("Món đặc sắc", Model.SignatureDishes)
            </div>
            <div class="space-y-2">
                @DisplayData("Số tầng/khu vực", Model.FloorCount)
                @DisplayData("Phòng riêng", Model.PrivateRoomCount)
                @DisplayData("Kiểu chỗ ngồi", Model.SeatingType)
                @DisplayData("Khung giờ đông khách", Model.BusyHours)
                @DisplayData("Khung giờ vắng khách", Model.SlowHours)
                @DisplayData("Địa điểm gần đó", Model.NearbyLandmark)
            </div>
            <div class="space-y-2">
                @DisplayData("Tiện ích cơ bản", Model.Amenities)
@*                @DisplayData("Tiện ích khác", string.IsNullOrWhiteSpace(Model.AmenitiesOther) ? "" : Model.AmenitiesOther)
*@                @DisplayData("Mô tả không gian", Model.SpaceDescription)
                @DisplayData("Mô tả chi tiết", Model.description)
            </div>
        </div>
    </div>

    <!-- Ảnh view gallery -->
    @if (Model.RestaurantImages != null && Model.RestaurantImages.Any())
    {
        <div class="pt-6 border-t">
            <h3 class="text-lg font-semibold text-gray-700 border-b pb-2 mb-3">Ảnh View (Gallery)</h3>
            <div class="flex flex-wrap gap-3">
                @foreach (var img in Model.RestaurantImages)
                {
                    <a href="@img.image_url" target="_blank" title="@img.description">
                        <img src="@img.image_url" alt="Ảnh View" class="w-32 h-20 object-cover rounded-md border shadow-sm hover:opacity-90 transition" />
                    </a>
                }
            </div>
        </div>
    }

    <!-- Quay lại / Edit -->
    <div class="pt-6 border-t mt-6 flex justify-between items-center">
        <a href="@Url.Action("Index")" class="text-gray-600 hover:text-gray-900">
            <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách
        </a>
        <a href="@Url.Action("Edit", new { id = Model.restaurant_id })" class="px-4 py-2 bg-blue-600 text-white font-semibold rounded-lg shadow-md hover:bg-blue-700 transition">
            <i class="fas fa-edit mr-1"></i> Chỉnh sửa
        </a>
    </div>
</div>
