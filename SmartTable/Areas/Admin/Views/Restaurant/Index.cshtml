@model IEnumerable<SmartTable.Models.Restaurants>
@{
    ViewBag.Title = "Quản lý Nhà hàng";
}

@section styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        .fas, .far, .fab, .fa-solid {
            font-family: "Font Awesome 6 Solid" !important;
            font-weight: 900 !important;
            display: inline-block !important;
            font-size: 0.9rem;
        }

        .btn-action-text {
            padding: 0.375rem 0.75rem;
            font-size: 0.75rem;
            font-weight: 600;
            border-radius: 0.375rem;
            box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);
            transition: all 0.2s ease-in-out;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none !important;
            line-height: 1.2;
            white-space: nowrap;
            color: white !important;
        }

            .btn-action-text:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            }

        #map-container {
            height: 450px;
            width: 100%;
            border-radius: 12px;
            box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.06);
            background-color: #e5e7eb;
            z-index: 1;
        }
    </style>
}

<h1 class="text-2xl font-bold text-gray-800 mb-6 border-b pb-2">Quản lý Tất cả Nhà hàng</h1>
<div class="flex flex-col lg:flex-row gap-8 mb-12">

    <!-- Bản đồ Vị trí -->
    <div class="lg:w-2/3 bg-white p-6 rounded-xl shadow-xl border border-gray-200">
        <div class="p-4 border-b flex justify-between items-center bg-gray-50 rounded-t-lg">
            <h2 class="text-xl font-semibold text-black flex items-center space-x-2">
                <i class="fas fa-map-marked-alt text-lg"></i>
                <span>Bản đồ Vị trí</span>
            </h2>
            <span class="text-xs text-gray-500 italic">Click "Map" ở bảng dưới để định vị</span>
        </div>
        <div id="map-container" class="rounded-lg shadow-sm mt-4"></div>
    </div>

    <!-- Thêm Nhà hàng Mới và Thống kê nhanh -->
    <div class="lg:w-1/3 space-y-8">

        <!-- Thêm Nhà hàng Mới -->
        <div class="bg-gradient-to-br from-blue-600 to-indigo-700 p-6 rounded-xl shadow-lg text-white">
            <h3 class="text-2xl font-bold mb-3 text-gray-800">Thêm Nhà hàng Mới</h3>
            <p class="text-sm mb-6 opacity-90 text-gray-800">Tạo hồ sơ nhà hàng mới, thiết lập vị trí và menu.</p>
            <a href="@Url.Action("Create")" class="inline-block bg-white text-blue-600 font-semibold py-3 px-6 rounded-lg shadow-lg hover:bg-gray-100 hover:text-blue-700 transition-all duration-300 ease-in-out transform hover:scale-105">
                <i class="fas fa-plus mr-2"></i> Tạo Mới Ngay
            </a>
        </div>

        <!-- Thống kê nhanh -->
        <div class="bg-white p-6 rounded-xl shadow-md border border-gray-200">
            <h3 class="font-semibold text-black mb-4 border-b pb-3">Thống kê nhanh</h3>
            <ul class="space-y-4">
                <li class="flex justify-between items-center">
                    <span class="text-black">Tổng số:</span>
                    <span class="bg-gray-100 text-black py-1 px-3 rounded-md font-semibold">@Model.Count()</span>
                </li>
                <li class="flex justify-between items-center">
                    <span class="text-black">Đã duyệt:</span>
                    <span class="bg-green-100 text-green-800 py-1 px-3 rounded-md font-semibold">@Model.Count(r => r.is_approved == true)</span>
                </li>
                <li class="flex justify-between items-center">
                    <span class="text-black">Chờ duyệt:</span>
                    <span class="bg-yellow-100 text-yellow-800 py-1 px-3 rounded-md font-semibold">@Model.Count(r => r.is_approved != true)</span>
                </li>
            </ul>
        </div>
    </div>
</div>



@if (TempData["SuccessMessage"] != null)
{
    <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded shadow-sm mb-6" role="alert">
        <p class="font-bold">Thành công!</p>
        <p>@TempData["SuccessMessage"]</p>
    </div>
}

<div class="bg-white shadow-xl rounded-lg overflow-hidden border border-gray-200">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-center text-xs font-bold text-gray-500 uppercase w-12">ID</th>
                    <th class="px-4 py-3 text-left text-xs font-bold text-gray-500 uppercase w-1/4">Nhà Hàng</th>
                    <th class="px-4 py-3 text-left text-xs font-bold text-gray-500 uppercase">Chủ sở hữu</th>
                    <th class="px-4 py-3 text-center text-xs font-bold text-gray-500 uppercase">Trạng thái</th>
                    <th class="px-4 py-3 text-center text-xs font-bold text-gray-500 uppercase">Hành động</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-4 text-center text-gray-700 font-medium">@item.restaurant_id</td>

                        <td class="px-4 py-4">
                            <div class="font-bold text-gray-800 text-sm">@item.name</div>
                            <div class="text-xs text-gray-500 truncate w-48" title="@item.address">@item.address</div>
                        </td>

                        <td class="px-4 py-4">
                            <div class="text-sm text-blue-600 font-medium">@(item.Users?.full_name ?? "Chưa gán")</div>
                            <div class="text-xs text-gray-400">ID: @(item.user_id ?? 0)</div>
                        </td>

                        <td class="px-4 py-4 text-center">
                            <span class="px-2 py-1 text-xs font-semibold rounded-full @(item.is_approved == true ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800")">
                                @(item.is_approved == true ? "Đã duyệt" : "Chờ duyệt")
                            </span>
                        </td>

                        <td class="px-4 py-4 text-center">
                            <div class="flex justify-center items-center gap-2">
                                @if (item.latitude.HasValue && item.longitude.HasValue)
                                {
                                    <button type="button"
                                            onclick="locateRestaurant(@item.restaurant_id, @item.latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture), @item.longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                            title="Xem trên bản đồ"
                                            class="btn-action-text bg-green-600 hover:bg-green-700 text-white">
                                        <i class="fas fa-location-arrow mr-1"></i> Map
                                    </button>
                                }
                                else
                                {
                                    <button type="button" disabled class="btn-action-text bg-gray-300 text-gray-500 cursor-not-allowed" title="Chưa có tọa độ">
                                        <i class="fas fa-map-marker-alt mr-1"></i> Map
                                    </button>
                                }

                                <a href="@Url.Action("Details", new { id = item.restaurant_id })"
                                   title="Chi tiết"
                                   class="btn-action-text bg-gray-600 hover:bg-gray-700">
                                    <i class="fas fa-eye mr-1"></i> Xem
                                </a>

                                <a href="@Url.Action("Edit", new { id = item.restaurant_id })"
                                   title="Sửa"
                                   class="btn-action-text bg-blue-600 hover:bg-blue-700">
                                    <i class="fas fa-edit mr-1"></i> Sửa
                                </a>

                                @using (Html.BeginForm("Delete", "Restaurant", new { id = item.restaurant_id, area = "Admin" }, FormMethod.Post, new { @class = "inline-block", onsubmit = "return confirm('CẢNH BÁO: Xóa nhà hàng sẽ xóa Booking và Review liên quan. Xác nhận xóa?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            title="Xóa"
                                            class="inline-flex items-center px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-md shadow-md transition-transform transform hover:scale-105 text-sm">
                                        <i class="fas fa-trash text-base mr-2"></i>
                                        Xóa
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        var map;
        var markers = {}; 
        const DEFAULT_POS = [10.8231, 106.6297];

        const RestaurantIcon = L.icon({
            iconUrl: '@Url.Content("~/Content/Images/RestaurantIcon.png")',
            iconSize: [45, 45], iconAnchor: [45, 45], popupAnchor: [0, -32]
        });

        document.addEventListener('DOMContentLoaded', function () {
            initMap();
        });

        function initMap() {
            // 1. Khởi tạo Map (Tắt scroll zoom để không bị cuộn trang nhầm)
            map = L.map('map-container', { scrollWheelZoom: false }).setView(DEFAULT_POS, 6);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            map.on('focus', () => map.scrollWheelZoom.enable());
            map.on('blur', () => map.scrollWheelZoom.disable());

            loadRestaurantMarkers();
        }

        function loadRestaurantMarkers() {
            // Gọi API lấy toàn bộ nhà hàng
            $.ajax({
                url: '@Url.Action("GetNearbyMapData", "Restaurant", new { area = "Admin" })',
                type: 'GET',
                data: { lat: 0, lng: 0, radiusKm: 99999 }, 
                dataType: 'json',
                success: function (data) {
                    var bounds = L.latLngBounds(); 

                    data.forEach(function (r) {
                        if (r.latitude && r.longitude) {
                            var key = r.restaurant_id;

                            var marker = L.marker([r.latitude, r.longitude], { icon: RestaurantIcon })
                                .addTo(map)
                                .bindPopup(`
                                    <div style="text-align:center">
                                        <h4 style="font-weight:bold; color:#2563EB; margin-bottom:4px;">${r.name}</h4>
                                        <p style="font-size:12px; margin-bottom:5px;">${r.address}</p>
                                        <a href="/Admin/Restaurant/Details/${r.restaurant_id}" style="color:blue; font-size:12px">Xem chi tiết</a>
                                    </div>
                                `);

                            markers[key] = marker;
                            bounds.extend([r.latitude, r.longitude]);
                        }
                    });

                    
                    if (data.length > 0) {
                        map.fitBounds(bounds, { padding: [50, 50] });
                    }
                },
                error: function(err) { console.error("Lỗi tải map:", err); }
            });
        }

        // ĐỊNH VỊ 
        window.locateRestaurant = function(id, lat, lng) {
            if(map) {    
                map.flyTo([lat, lng], 16, { animate: true, duration: 1.5 });
                if(markers[id]) {
                    markers[id].openPopup();
                } else {
                    L.marker([lat, lng], { icon: RestaurantIcon }).addTo(map)
                        .bindPopup(`Đang tải...`).openPopup();
                }
                document.getElementById('map-container').scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        };
    </script>
}