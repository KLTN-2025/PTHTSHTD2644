@model SmartTable.Models.ViewModels.AdminChangePasswordViewModel

@{
    ViewBag.Title = "Đổi mật khẩu tài khoản";
}

<div class="max-w-xl mx-auto bg-white shadow-lg rounded-lg p-6 mt-6">
    <h1 class="text-2xl font-bold text-gray-800 mb-2">
        Đổi mật khẩu tài khoản
    </h1>
    <p class="text-sm text-gray-600 mb-4">
        Quản trị viên cập nhật mật khẩu mới cho tài khoản doanh nghiệp / người dùng.
    </p>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-3 text-sm text-red-700 bg-red-100 border border-red-300 rounded px-3 py-2">
            @TempData["ErrorMessage"]
        </div>
    }

    @using (Html.BeginForm("ChangePassword", "Users", new { area = "Admin" }, FormMethod.Post, new { @class = "space-y-4" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.UserId)

        <div class="bg-gray-50 border border-gray-200 rounded-lg p-3 mb-2">
            <div class="text-sm text-gray-700">
                <span class="font-semibold">Tài khoản:</span>
                <span class="ml-1 text-gray-900">@Model.FullName</span>
            </div>
            <div class="text-sm text-gray-700">
                <span class="font-semibold">Email:</span>
                <span class="ml-1 text-gray-900">@Model.Email</span>
            </div>
            <div class="text-sm text-gray-700">
                <span class="font-semibold">Vai trò:</span>
                <span class="ml-1 text-blue-700 font-medium">@Model.Role</span>
            </div>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
                Mật khẩu mới
            </label>
            @Html.PasswordFor(m => m.NewPassword, new { @class = "w-full p-2 border rounded-lg", placeholder = "Nhập mật khẩu mới" })
            @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-xs text-red-600" })
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
                Xác nhận mật khẩu mới
            </label>
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "w-full p-2 border rounded-lg", placeholder = "Nhập lại mật khẩu mới" })
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-xs text-red-600" })
        </div>

        @Html.ValidationSummary(true, "", new { @class = "text-xs text-red-600 bg-red-50 border border-red-200 rounded p-2" })

        <div class="flex justify-between items-center pt-4 border-t mt-4">
            <a href="@Url.Action("Index", "Users", new { area = "Admin" })"
               class="px-4 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-sm text-gray-800">
                ← Quay lại danh sách
            </a>

            <button type="submit"
                    class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg shadow">
                <i class="fas fa-key mr-1"></i> Cập nhật mật khẩu
            </button>
        </div>
    }
</div>
