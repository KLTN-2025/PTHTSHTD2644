@model IEnumerable<SmartTable.Models.Tables>
@{
    ViewBag.Title = "Quản lý bàn";
    Layout = "~/Views/Shared/_BusinessLayout.cshtml";
}

<div class="bg-gray-50 min-h-screen py-8">
    <div class="container mx-auto max-w-5xl px-4">

        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Quản lý bàn</h1>
                <p class="text-sm text-gray-500 mt-1">
                    Thiết lập sơ đồ bàn & sức chứa để hệ thống kiểm tra còn chỗ khi khách đặt.
                </p>
                @if (ViewBag.RestaurantName != null)
                {
                    <p class="text-xs text-gray-400 mt-1">
                        Nhà hàng: <span class="font-semibold text-gray-700">@ViewBag.RestaurantName</span>
                    </p>
                }
            </div>

            <a href="@Url.Action("Create", "BusinessTables")"
               class="inline-flex items-center px-4 py-2 bg-red-600 text-white text-sm font-semibold rounded-lg shadow hover:bg-red-700">
                <i class="fas fa-plus mr-2"></i> Thêm bàn mới
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-4 px-4 py-3 rounded-lg bg-green-50 border border-green-200 text-green-800 text-sm flex items-center gap-2">
                <i class="fas fa-check-circle"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-800 text-sm flex items-center gap-2">
                <i class="fas fa-exclamation-triangle"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <table class="min-w-full text-sm">
                <thead class="bg-gray-100 text-gray-700 uppercase text-xs">
                    <tr>
                        <th class="px-4 py-3 text-left">Mã bàn</th>
                        <th class="px-4 py-3 text-center">Sức chứa</th>
                        <th class="px-4 py-3 text-left">Loại bàn</th>
                        <th class="px-4 py-3 text-center">Trạng thái</th>
                        <th class="px-4 py-3 text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var t in Model)
                        {
                            var isAvailable = t.is_available ?? true;
                            <tr class="hover:bg-gray-50">
                                <td class="px-4 py-3 font-semibold text-gray-800">@t.table_number</td>
                                <td class="px-4 py-3 text-center">@t.capacity</td>
                                <td class="px-4 py-3">
                                    @(string.IsNullOrEmpty(t.type) ? "-" : t.type)
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold
                                        @(isAvailable ? "bg-green-50 text-green-700" : "bg-gray-100 text-gray-500")">
                                        @(isAvailable ? "Đang mở" : "Tạm khóa")
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <a href="@Url.Action("Edit", "BusinessTables", new { id = t.table_id })"
                                       class="inline-flex items-center px-2 py-1 text-xs text-blue-600 hover:text-blue-800">
                                        <i class="fas fa-edit mr-1"></i>Sửa
                                    </a>

                                    @using (Html.BeginForm("Toggle", "BusinessTables", FormMethod.Post, new { @class = "inline-block ml-2" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", t.table_id)
                                        <button type="submit"
                                                class="text-xs px-2 py-1 rounded border
                                                       @(isAvailable ? "border-gray-300 text-gray-600 hover:bg-gray-100" : "border-green-500 text-green-600 hover:bg-green-50")">
                                            @(isAvailable ? "Khóa" : "Mở")
                                        </button>
                                    }

                                    @using (Html.BeginForm("Delete", "BusinessTables", FormMethod.Post, new { @class = "inline-block ml-2" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", t.table_id)
                                        <button type="submit"
                                                onclick="return confirm('Bạn chắc chắn muốn xóa bàn này?');"
                                                class="text-xs text-red-600 hover:text-red-800">
                                            <i class="fas fa-trash-alt mr-1"></i>Xóa
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-4 py-6 text-center text-gray-500 text-sm">
                                Chưa có bàn nào. Vui lòng nhấn <strong>“Thêm bàn mới”</strong> để cấu hình sơ đồ bàn.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>
