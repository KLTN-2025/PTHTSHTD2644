@model SmartTable.Models.Restaurants
@using System.Collections.Generic
@using SmartTable.Models

@{
    ViewBag.Title = "Đặt bàn - " + Model.name;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var user = Session["user"] as SmartTable.Models.Users;
    var userName = user != null ? user.full_name : "";
    var userPhone = user != null ? user.phone : "";

    string preDate;
    if (ViewBag.PreSelectedDate != null)
    {
        try
        {
            DateTime d = (DateTime)ViewBag.PreSelectedDate;
            preDate = d.ToString("yyyy-MM-dd");
        }
        catch
        {
            preDate = DateTime.Now.ToString("yyyy-MM-dd");
        }
    }
    else
    {
        preDate = DateTime.Now.ToString("yyyy-MM-dd");
    }

    int prePeople = 2;
    if (ViewBag.PreSelectedPeople != null)
    {
        int temp;
        if (int.TryParse(ViewBag.PreSelectedPeople.ToString(), out temp))
        {
            prePeople = temp;
        }
    }

    string preTime = null;
    if (ViewBag.PreSelectedTime != null)
    {
        preTime = ViewBag.PreSelectedTime.ToString(); // "HH:mm"
    }

    string startHourStr = "09:00";
    string endHourStr = "22:00";

    if (!string.IsNullOrEmpty(Model.opening_hours))
    {
        var parts = Model.opening_hours.Split(new[] { '-', '–' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 1)
        {
            startHourStr = parts[0].Trim();
        }
        if (parts.Length >= 2)
        {
            endHourStr = parts[1].Trim();
        }
    }

    TimeSpan openTime;
    TimeSpan closeTime;

    if (!TimeSpan.TryParse(startHourStr, out openTime))
    {
        openTime = new TimeSpan(9, 0, 0);
    }

    if (!TimeSpan.TryParse(endHourStr, out closeTime))
    {
        closeTime = new TimeSpan(22, 0, 0);
    }

    var timeSlots = new List<string>();
    var current = openTime;

    while (current <= closeTime.Subtract(TimeSpan.FromMinutes(60)))
    {
        timeSlots.Add(current.ToString(@"hh\:mm"));
        current = current.Add(TimeSpan.FromMinutes(30));
    }

    var preDateDisplay = DateTime.Parse(preDate).ToString("dd/MM/yyyy");

    var menuItems = ViewBag.MenuItems as List<MenuItems> ?? new List<MenuItems>();
}

<div class="bg-gray-50 min-h-screen py-10 font-sans">
    <div class="container mx-auto max-w-6xl px-4">

        <div class="mb-6">
            <a href="@Url.Action("RestaurantDetails", "DetailNhaHang", new { id = Model.restaurant_id })"
               class="text-gray-500 hover:text-blue-600 text-sm flex items-center gap-1 mb-2 transition group">
                <i class="fas fa-arrow-left group-hover:-translate-x-1 transition-transform"></i> Quay lại chi tiết nhà hàng
            </a>
            <h1 class="text-3xl font-bold text-gray-800">Xác nhận đặt chỗ</h1>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mt-3 bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-2 rounded-lg">
                    <i class="fas fa-exclamation-circle mr-1"></i> @TempData["ErrorMessage"]
                </div>
            }
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <div class="lg:col-span-2">
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="bg-gradient-to-r from-blue-600 to-blue-700 p-5 text-white flex items-center gap-4">
                        <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
                            <i class="fas fa-calendar-alt text-xl"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-lg">Thông tin đặt bàn</h3>
                            <p class="text-xs text-blue-100 opacity-90">Vui lòng điền đầy đủ thông tin bên dưới</p>
                        </div>
                    </div>

                    <div class="p-6 md:p-8">
                        @using (Html.BeginForm("LuuDatBan", "DatBan", FormMethod.Post, new { id = "bookingForm", @class = "space-y-8" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("restaurant_id", Model.restaurant_id)

                            <div class="space-y-6">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="block text-sm font-bold text-gray-700 mb-2">
                                            Ngày đến <span class="text-red-500">*</span>
                                        </label>
                                        <input type="date"
                                               name="booking_time"
                                               id="inputDate"
                                               required
                                               value="@preDate"
                                               min="@DateTime.Now.ToString("yyyy-MM-dd")"
                                               class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none transition bg-gray-50 focus:bg-white font-medium text-gray-700" />
                                    </div>

                                    <div>
                                        <label class="block text-sm font-bold text-gray-700 mb-2">
                                            Giờ đến <span class="text-red-500">*</span>
                                            <span class="text-xs font-normal text-gray-500 ml-1">(Mở cửa: @startHourStr - @endHourStr)</span>
                                        </label>

                                        <input type="hidden" name="booking_time_hour"
                                               id="selectedTimeInput"
                                               value="@(string.IsNullOrEmpty(preTime) ? "" : preTime)" />

                                        <div class="grid grid-cols-4 gap-2 max-h-40 overflow-y-auto pr-1 custom-scrollbar">
                                            @if (timeSlots.Count > 0)
                                            {
                                                foreach (var slot in timeSlots)
                                                {
                                                    var isDefault = (!string.IsNullOrEmpty(preTime) && slot == preTime);

                                                    var btnClass = "time-slot-btn py-2 px-1 text-sm font-medium border rounded-lg ";
                                                    btnClass += isDefault
                                                        ? "bg-blue-600 text-white border-blue-600 shadow-md"
                                                        : "bg-white text-gray-600 border-gray-200 hover:border-blue-500 hover:text-blue-600 transition";

                                                    <button type="button"
                                                            onclick="selectTime(this, '@slot')"
                                                            class="@btnClass">
                                                        @slot
                                                    </button>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-sm text-red-500 col-span-4">
                                                    Vui lòng liên hệ nhà hàng để biết giờ mở cửa.
                                                </span>
                                            }
                                        </div>
                                        <p class="text-xs text-red-500 mt-1 hidden font-medium" id="timeError">
                                            <i class="fas fa-exclamation-circle"></i> Vui lòng chọn giờ đến.
                                        </p>
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-sm font-bold text-gray-700 mb-3">
                                        Số lượng khách <span class="text-red-500">*</span>
                                    </label>

                                    <input type="number"
                                           id="number_of_guests"
                                           name="number_of_guests"
                                           min="1"
                                           value="@prePeople"
                                           class="w-full max-w-xs p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none transition bg-gray-50 focus:bg-white text-sm font-medium text-gray-700" />

                                    <p class="text-xs text-gray-500 mt-1">
                                        Vui lòng nhập đúng số lượng khách thực tế.
                                    </p>
                                </div>
                            </div>

                            <div class="border-t border-gray-100 my-6"></div>

                            <div class="space-y-6 mt-6">
                                <h4 class="font-bold text-gray-800 text-base">Thông tin liên hệ</h4>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">
                                            Họ và tên <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text"
                                               name="full_name"
                                               required
                                               value="@userName"
                                               placeholder="VD: Nguyễn Văn A"
                                               class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none transition bg-gray-50 focus:bg-white" />
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">
                                            Số điện thoại <span class="text-red-500">*</span>
                                        </label>
                                        <input type="tel"
                                               name="phone"
                                               required
                                               value="@userPhone"
                                               placeholder="VD: 0912..."
                                               class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none transition bg-gray-50 focus:bg-white" />
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">
                                        Ghi chú (Tùy chọn)
                                    </label>
                                    <textarea name="special_request"
                                              rows="3"
                                              placeholder="VD: Tôi muốn ngồi gần cửa sổ, có trẻ em, tổ chức sinh nhật..."
                                              class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none transition bg-gray-50 focus:bg-white"></textarea>
                                </div>
                            </div>

                            if (menuItems.Any())
                            {
                                <div class="mt-10">
                                    <div class="text-center mb-4">
                                        <h4 class="font-bold text-gray-900 text-lg">
                                            Đặt món trước cho bữa ăn của bạn
                                        </h4>
                                        <p class="text-xs text-gray-500 mb-3">
                                            Chọn món bạn muốn nhà hàng chuẩn bị trước. Giá chỉ mang tính tham khảo.
                                        </p>
                                    </div>

                                    <input type="hidden" id="pre_order_note" name="pre_order_note" />
                                    <input type="hidden" id="pre_order_total" name="pre_order_total" />

                                    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                                        <div class="max-h-72 overflow-y-auto custom-scrollbar divide-y divide-gray-100">
                                            @foreach (var item in menuItems)
                                            {
                                                var imageUrl = string.IsNullOrEmpty(item.Image)
                                                    ? "https://via.placeholder.com/200x150?text=Mon+an"
                                                    : item.Image;

                                                <div class="preorder-row px-3 py-3 md:px-4 md:py-4 flex flex-col md:flex-row md:items-center gap-3">
                                                    <div class="w-full md:w-24 md:h-24 h-32 rounded-xl overflow-hidden bg-gray-100 flex-shrink-0">
                                                        <img src="@imageUrl"
                                                             alt="@item.name"
                                                             class="w-full h-full object-cover transform hover:scale-105 transition duration-500" />
                                                    </div>

                                                    <div class="flex-1 min-w-0">
                                                        <div class="flex items-center gap-2 mb-1">
                                                            <h5 class="text-sm md:text-base font-semibold text-gray-900 truncate">
                                                                @item.name
                                                            </h5>
                                                            @if (!string.IsNullOrWhiteSpace(item.category))
                                                            {
                                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-blue-50 text-blue-700 border border-blue-100">
                                                                    @item.category
                                                                </span>
                                                            }
                                                        </div>

                                                        @if (!string.IsNullOrWhiteSpace(item.description))
                                                        {
                                                            <p class="text-[11px] md:text-xs text-gray-500 line-clamp-2 md:line-clamp-3">
                                                                @item.description
                                                            </p>
                                                        }

                                                        <div class="mt-2 flex items-center gap-2">
                                                            <span class="text-xs text-gray-400">Giá tham khảo:</span>
                                                            <span class="text-sm md:text-base font-bold text-red-600">
                                                                @item.price.ToString("N0") đ
                                                            </span>
                                                        </div>
                                                    </div>

                                                    <div class="flex md:flex-col items-center md:items-end gap-2 md:gap-3">
                                                        <div class="flex items-center gap-1">
                                                            <span class="hidden md:inline text-[11px] text-gray-500">SL</span>
                                                            <input type="number"
                                                                   min="1"
                                                                   value="1"
                                                                   class="preorder-qty w-16 p-1.5 border border-gray-200 rounded-lg text-xs text-center focus:ring-1 focus:ring-blue-500 focus:border-blue-500" />
                                                        </div>

                                                        <label class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-700 cursor-pointer">
                                                            <input type="checkbox"
                                                                   class="preorder-check rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                                                                   data-name="@item.name"
                                                                   data-price="@item.price" />
                                                            <span>Chọn món</span>
                                                        </label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="mt-6 text-center">
                                    <p class="text-xs text-gray-400 italic">
                                        Nhà hàng chưa cập nhật thực đơn để đặt món trước.
                                    </p>
                                </div>
                            }

                            <div class="mt-8">
                                <button type="submit"
                                        class="w-full bg-red-600 text-white text-lg font-bold py-4 rounded-xl shadow-lg hover:bg-red-700 hover:shadow-xl hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 group">
                                    <span>HOÀN TẤT ĐẶT BÀN</span>
                                    <i class="fas fa-check-circle group-hover:scale-110 transition-transform"></i>
                                </button>

                                <p class="text-center text-xs text-gray-500 mt-2">
                                    Bằng cách nhấn hoàn tất, bạn đồng ý với
                                    <a href="#" class="text-blue-600 hover:underline font-medium">Điều khoản sử dụng</a>
                                    của chúng tôi.
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="lg:col-span-1">
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 sticky top-24">

                    <div class="relative h-48 rounded-xl overflow-hidden mb-5 bg-gray-100 shadow-inner">
                        <img src="@(Model.Image ?? "https://via.placeholder.com/400x300")"
                             class="w-full h-full object-cover transition hover:scale-105 duration-700"
                             alt="@Model.name">
                        <div class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-black/80 to-transparent p-4">
                            <h2 class="text-xl font-bold text-white leading-tight">@Model.name</h2>
                        </div>
                    </div>

                    <div class="space-y-4 text-sm text-gray-600 mb-6">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-full bg-red-50 text-red-500 flex items-center justify-center shrink-0">
                                <i class="fas fa-map-marker-alt"></i>
                            </div>
                            <span class="mt-1">@Model.address</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-green-50 text-green-600 flex items-center justify-center shrink-0">
                                <i class="fas fa-clock"></i>
                            </div>
                            <span>@Model.opening_hours</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-orange-50 text-orange-500 flex items-center justify-center shrink-0">
                                <i class="fas fa-utensils"></i>
                            </div>
                            <span>@Model.CuisineStyle</span>
                        </div>
                    </div>

                    <hr class="border-dashed border-gray-200 my-5" />

                    <div class="bg-blue-50 p-4 rounded-xl border border-blue-100">
                        <h5 class="font-bold text-blue-800 text-xs uppercase mb-3 flex items-center gap-2">
                            <i class="fas fa-receipt"></i> Tóm tắt đặt chỗ
                        </h5>
                        <div class="space-y-2 text-sm">
                            <div class="flex justify-between">
                                <span class="text-gray-500">Ngày:</span>
                                <span class="font-bold text-gray-800" id="summaryDate">
                                    @preDateDisplay
                                </span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-500">Giờ:</span>
                                <span class="font-bold text-blue-600" id="summaryTime">
                                    @(string.IsNullOrEmpty(preTime) ? "--:--" : preTime)
                                </span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-500">Số khách:</span>
                                <span class="font-bold text-gray-800" id="summaryPeople">
                                    @prePeople khách
                                </span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-500">Tiền món ước tính:</span>
                                <span class="font-bold text-gray-800" id="summaryPreOrder">
                                    0 đ
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 bg-yellow-50 border border-yellow-200 rounded-lg p-3 text-xs text-yellow-800 leading-relaxed">
                        <i class="fas fa-info-circle mr-1"></i>
                        <strong>Lưu ý:</strong> Bàn đặt của bạn sẽ được giữ tối đa 15 phút. Vui lòng đến đúng giờ.
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectTime(btn, timeVal) {
            document.querySelectorAll('.time-slot-btn').forEach(function (b) {
                b.classList.remove("bg-blue-600", "text-white", "border-blue-600", "shadow-md");
                b.classList.add("bg-white", "text-gray-600", "border-gray-200");
            });

            btn.classList.remove("bg-white", "text-gray-600", "border-gray-200");
            btn.classList.add("bg-blue-600", "text-white", "border-blue-600", "shadow-md");

            document.getElementById('selectedTimeInput').value = timeVal;
            document.getElementById('summaryTime').textContent = timeVal;
            var err = document.getElementById('timeError');
            if (err) err.classList.add('hidden');
        }

        var inputDate = document.getElementById('inputDate');
        if (inputDate) {
            inputDate.addEventListener('change', function () {
                if (this.value) {
                    var d = new Date(this.value);
                    var txt = d.toLocaleDateString('vi-VN');
                    document.getElementById('summaryDate').textContent = txt;
                }
            });
        }

        var guestInput = document.getElementById('number_of_guests');
        if (guestInput) {
            var updateGuestSummary = function () {
                var v = parseInt(guestInput.value, 10);
                if (isNaN(v) || v < 1) v = 1;
                guestInput.value = v;
                document.getElementById('summaryPeople').textContent = v + " khách";
            };
            guestInput.addEventListener('change', updateGuestSummary);
            guestInput.addEventListener('keyup', updateGuestSummary);
            updateGuestSummary();
        }

        // ====== ĐẶT MÓN TRƯỚC: tính tổng & build note ======
        function updatePreOrderSummary() {
            var total = 0;

            document.querySelectorAll('.preorder-row').forEach(function (row) {
                var cb = row.querySelector('.preorder-check');
                if (cb && cb.checked) {
                    var price = parseFloat(cb.getAttribute('data-price') || '0');
                    var qtyInput = row.querySelector('.preorder-qty');
                    var qty = 1;
                    if (qtyInput) {
                        var parsed = parseInt(qtyInput.value, 10);
                        if (!isNaN(parsed) && parsed > 0) qty = parsed;
                    }
                    total += price * qty;
                }
            });

            var summary = document.getElementById('summaryPreOrder');
            if (summary) {
                summary.textContent = total.toLocaleString('vi-VN') + " đ";
            }

            var totalField = document.getElementById('pre_order_total');
            if (totalField) {
                totalField.value = total.toString();
            }
        }

        document.querySelectorAll('.preorder-check').forEach(function (cb) {
            cb.addEventListener('change', updatePreOrderSummary);
        });
        document.querySelectorAll('.preorder-qty').forEach(function (input) {
            input.addEventListener('change', updatePreOrderSummary);
            input.addEventListener('keyup', updatePreOrderSummary);
        });

        var bookingForm = document.getElementById('bookingForm');
        if (bookingForm) {
            bookingForm.addEventListener('submit', function (e) {
                var time = document.getElementById('selectedTimeInput').value;
                if (!time) {
                    e.preventDefault();
                    var err = document.getElementById('timeError');
                    if (err) {
                        err.classList.remove('hidden');
                        err.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                    return;
                }

                var lines = [];
                document.querySelectorAll('.preorder-row').forEach(function (row) {
                    var cb = row.querySelector('.preorder-check');
                    if (cb && cb.checked) {
                        var name = cb.getAttribute('data-name');
                        var price = parseFloat(cb.getAttribute('data-price') || '0');
                        var qtyInput = row.querySelector('.preorder-qty');
                        var qty = 1;
                        if (qtyInput) {
                            var parsed = parseInt(qtyInput.value, 10);
                            if (!isNaN(parsed) && parsed > 0) qty = parsed;
                        }
                        var priceTxt = price.toLocaleString('vi-VN') + " đ";
                        lines.push(qty + " x " + name + " (" + priceTxt + ")");
                    }
                });

                var noteField = document.getElementById('pre_order_note');
                if (noteField) {
                    noteField.value = lines.join("; ");
                }

                updatePreOrderSummary();
            });
        }

        updatePreOrderSummary();
    </script>

    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

            .custom-scrollbar::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }
    </style>
}
