@model IEnumerable<SmartTable.Models.ViewModels.BookingHistoryItemViewModel>

@using System;
@using System.Linq;
@using System.Globalization;
@using System.Collections.Generic;

@{
    ViewBag.Title = "Lịch sử đặt bàn";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var statusFilter = (Request["status"] ?? "all").Trim().ToLowerInvariant();
    var paymentFilter = (Request["payment"] ?? "all").Trim().ToLowerInvariant();
    var methodFilter = (Request["method"] ?? "all").Trim().ToLowerInvariant();

    var data = Model ?? Enumerable.Empty<SmartTable.Models.ViewModels.BookingHistoryItemViewModel>();

    var vi = CultureInfo.GetCultureInfo("vi-VN");
    Func<decimal, string> money = v => v.ToString("#,##0", vi) + " đ";
    Func<string, string> norm = s => (s ?? "").Trim();
    Func<string, bool> isAll = v => string.IsNullOrWhiteSpace(v) || v == "all";

    bool anyFilterApplied = !isAll(statusFilter) || !isAll(paymentFilter) || !isAll(methodFilter);

    Func<string, string> safeImg = url =>
        string.IsNullOrWhiteSpace(url)
            ? "https://via.placeholder.com/200x200.png?text=Restaurant"
            : url;

    Func<string, string, bool> containsAny = (text, keys) =>
    {
        if (string.IsNullOrWhiteSpace(text)) return false;
        foreach (var k in keys.Split('|'))
        {
            var key = (k ?? "").Trim();
            if (key.Length == 0) continue;
            if (text.IndexOf(key, StringComparison.OrdinalIgnoreCase) >= 0) return true;
        }
        return false;
    };

    Func<SmartTable.Models.ViewModels.BookingHistoryItemViewModel, string> bookingStatusText = x =>
        norm(x?.BookingStatus);

    Func<SmartTable.Models.ViewModels.BookingHistoryItemViewModel, bool> isCancelled = x =>
        containsAny(bookingStatusText(x), "hủy|huỷ|cancel");

    Func<SmartTable.Models.ViewModels.BookingHistoryItemViewModel, string> bookingStatusKey = x =>
    {
        var s = bookingStatusText(x).ToLowerInvariant();

        if (isCancelled(x)) return "cancelled";
        if (containsAny(s, "đã thanh toán|paid|payment|đã trả")) return "paid";
        if (containsAny(s, "đã cọc|cọc thành công|deposited|deposit")) return "deposited";
        if (containsAny(s, "đã xác nhận|confirmed")) return "confirmed";
        if (containsAny(s, "đã đặt|booked")) return "booked";
        if (containsAny(s, "chờ|pending")) return "pending";

        return "other";
    };

    Func<SmartTable.Models.ViewModels.BookingHistoryItemViewModel, string> bookingStatusLabel = x =>
    {
        var key = bookingStatusKey(x);
        if (key == "cancelled") return "Đã hủy";
        if (key == "paid") return "Đã thanh toán";
        if (key == "deposited") return "Đã cọc";
        if (key == "confirmed") return "Đã xác nhận";
        if (key == "booked") return "Đã đặt";
        if (key == "pending") return "Chờ xác nhận";
        var raw = bookingStatusText(x);
        return string.IsNullOrWhiteSpace(raw) ? "Chờ xác nhận" : raw;
    };

    Func<SmartTable.Models.ViewModels.BookingHistoryItemViewModel, string> paymentStatusText = x =>
        norm(x?.PaymentStatus);

    Func<SmartTable.Models.ViewModels.BookingHistoryItemViewModel, bool> hasRefund = x =>
        containsAny(paymentStatusText(x), "hoàn|refund|reversed|reverse");

    Func<SmartTable.Models.ViewModels.BookingHistoryItemViewModel, bool> isPendingPayment = x =>
        containsAny(paymentStatusText(x), "chờ|pending|processing|xác nhận|await");

    Func<SmartTable.Models.ViewModels.BookingHistoryItemViewModel, bool> isPaid = x =>
        !hasRefund(x) && containsAny(paymentStatusText(x), "đã cọc|cọc thành công|đã thanh toán|paid|success|completed|thành công");

    Func<SmartTable.Models.ViewModels.BookingHistoryItemViewModel, string> paymentStatusKey = x =>
    {
        if (hasRefund(x)) return "refunded";
        if (isPaid(x)) return "paid";
        if (isPendingPayment(x)) return "pending";
        return "unpaid";
    };

    Func<SmartTable.Models.ViewModels.BookingHistoryItemViewModel, string> paymentStatusLabel = x =>
    {
        var raw = paymentStatusText(x);
        if (hasRefund(x)) return "Đã hoàn";
        if (isPaid(x)) return "Đã thanh toán";
        if (isPendingPayment(x)) return "Chờ xác nhận";
        return string.IsNullOrWhiteSpace(raw) ? "Chưa thanh toán" : raw;
    };

    Func<SmartTable.Models.ViewModels.BookingHistoryItemViewModel, string> paymentMethodLabel = x =>
    {
        var mRaw = norm(x?.PaymentMethod);
        var m = mRaw.ToLowerInvariant();

        if (m.Contains("vnpay")) return "VNPAY";
        if (m.Contains("chuyển") || m.Contains("bank") || m.Contains("transfer")) return "Chuyển khoản";
        if (m.Contains("tiền mặt") || m.Contains("cash")) return "Tiền mặt";

        var ps = paymentStatusText(x).ToLowerInvariant();
        if (ps.Contains("vnpay")) return "VNPAY";

        return string.IsNullOrWhiteSpace(mRaw) ? "Khác" : mRaw;
    };

    Func<SmartTable.Models.ViewModels.BookingHistoryItemViewModel, string> methodKey = x =>
    {
        var m = paymentMethodLabel(x).ToLowerInvariant();
        if (m.Contains("vnpay")) return "vnpay";
        if (m.Contains("khoản") || m.Contains("bank")) return "bank";
        if (m.Contains("mặt") || m.Contains("cash")) return "cash";
        return "other";
    };

    if (!isAll(statusFilter))
    {
        data = data.Where(x => bookingStatusKey(x) == statusFilter);
    }
    if (!isAll(paymentFilter))
    {
        data = data.Where(x => paymentStatusKey(x) == paymentFilter);
    }
    if (!isAll(methodFilter))
    {
        data = data.Where(x => methodKey(x) == methodFilter);
    }

    var list = data.ToList();

    var totalCount = list.Count;
    var paidCount = list.Count(x => paymentStatusKey(x) == "paid");
    var pendingCount = list.Count(x => paymentStatusKey(x) == "pending");
    var unpaidCount = list.Count(x => paymentStatusKey(x) == "unpaid");
}

<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-8">
    <div class="container mx-auto max-w-6xl px-4 lg:px-8">

        <!-- Header -->
        <div class="mb-8">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">Lịch sử đặt bàn</h1>
                    <p class="text-gray-600 mt-1">Theo dõi đơn đặt bàn, thanh toán và món đặt trước của bạn</p>
                </div>

                <a href="@Url.Action("Index","Home")"
                   class="inline-flex items-center gap-2 px-5 py-3 bg-white text-gray-700 font-semibold rounded-xl shadow-sm hover:shadow-md border border-gray-200 hover:border-blue-400 transition-all duration-300">
                    <i class="fas fa-home text-lg" style="color:#111827 !important;"></i>
                    <span>Về trang chủ</span>
                </a>
            </div>
        </div>

        <!-- Filters -->
        <div class="mb-8">
            <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6">
                <div class="flex items-center justify-between gap-3 mb-4">
                    <div class="flex items-center gap-2">
                        <i class="fas fa-sliders-h text-blue-600"></i>
                        <h3 class="text-lg font-semibold text-gray-800">Bộ lọc tìm kiếm</h3>
                    </div>

                    @if (anyFilterApplied)
                    {
                        <span class="text-xs font-semibold px-3 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-100">
                            Đang áp dụng bộ lọc
                        </span>
                    }
                </div>

                <form method="get" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                <i class="fas fa-calendar-check mr-1 text-blue-500"></i>Trạng thái đặt bàn
                            </label>
                            <select name="status"
                                    class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl text-gray-700 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all">
                                <option value="all" @(isAll(statusFilter) ? "selected" : "")>Tất cả</option>
                                <option value="pending" @(statusFilter == "pending" ? "selected" : "")>Chờ xác nhận</option>
                                <option value="booked" @(statusFilter == "booked" ? "selected" : "")>Đã đặt</option>
                                <option value="confirmed" @(statusFilter == "confirmed" ? "selected" : "")>Đã xác nhận</option>
                                <option value="deposited" @(statusFilter == "deposited" ? "selected" : "")>Đã cọc</option>
                                <option value="paid" @(statusFilter == "paid" ? "selected" : "")>Đã thanh toán</option>
                                <option value="cancelled" @(statusFilter == "cancelled" ? "selected" : "")>Đã hủy</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                <i class="fas fa-credit-card mr-1 text-purple-500"></i>Trạng thái thanh toán
                            </label>
                            <select name="payment"
                                    class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl text-gray-700 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all">
                                <option value="all" @(isAll(paymentFilter) ? "selected" : "")>Tất cả</option>
                                <option value="paid" @(paymentFilter == "paid" ? "selected" : "")>Đã thanh toán</option>
                                <option value="pending" @(paymentFilter == "pending" ? "selected" : "")>Chờ xác nhận</option>
                                <option value="unpaid" @(paymentFilter == "unpaid" ? "selected" : "")>Chưa thanh toán</option>
                                <option value="refunded" @(paymentFilter == "refunded" ? "selected" : "")>Đã hoàn</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                <i class="fas fa-receipt mr-1 text-amber-500"></i>Phương thức
                            </label>
                            <select name="method"
                                    class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl text-gray-700 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all">
                                <option value="all" @(isAll(methodFilter) ? "selected" : "")>Tất cả</option>
                                <option value="vnpay" @(methodFilter == "vnpay" ? "selected" : "")>VNPAY</option>
                                <option value="bank" @(methodFilter == "bank" ? "selected" : "")>Chuyển khoản</option>
                                <option value="cash" @(methodFilter == "cash" ? "selected" : "")>Tiền mặt</option>
                                <option value="other" @(methodFilter == "other" ? "selected" : "")>Khác</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex items-center justify-between gap-3 pt-4 border-t border-gray-100">
                        <button type="submit"
                                class="inline-flex items-center justify-center gap-3 px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl hover:from-blue-700 hover:to-blue-800 transition-all duration-300">
                            <i class="fas fa-filter text-white"></i>
                            <span>Áp dụng bộ lọc</span>
                        </button>

                        @if (anyFilterApplied)
                        {
                            <a href="@Url.Action("DanhSachBanDaDat","DatBan")"
                               class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-white text-gray-700 font-semibold rounded-lg border border-gray-300 hover:bg-gray-50 hover:border-gray-400 transition-all duration-300 text-sm">
                                <i class="fas fa-times-circle" style="color:#dc2626 !important;"></i>
                                <span>Xóa lọc</span>
                            </a>
                        }
                    </div>

                    <p class="text-xs text-gray-500">
                        Tip: Chọn lọc xong bấm <b>Áp dụng bộ lọc</b>. Nút <b>Xóa lọc</b> chỉ xuất hiện khi bạn đang lọc.
                    </p>
                </form>
            </div>
        </div>

        @if (!list.Any())
        {
            <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-12 text-center">
                <div class="max-w-md mx-auto">
                    <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-gradient-to-br from-blue-50 to-blue-100 flex items-center justify-center">
                        <i class="fas fa-calendar-times text-3xl text-blue-500"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-800 mb-3">Không có đặt bàn nào</h3>
                    <p class="text-gray-600 mb-8">Không có đơn phù hợp với bộ lọc hiện tại. Bạn có thể xóa lọc và thử lại.</p>
                    <a href="@Url.Action("Index","Home")"
                       class="inline-flex items-center gap-3 px-8 py-3.5 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl hover:from-emerald-600 hover:to-emerald-700 transition-all duration-300">
                        <i class="fas fa-plus-circle text-white"></i>
                        <span>Đặt bàn mới</span>
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Summary -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm text-gray-500">Tổng đơn</p>
                            <p class="text-2xl font-bold text-gray-800">@totalCount</p>
                        </div>
                        <div class="p-3 bg-blue-600 rounded-xl">
                            <i class="fas fa-list-alt text-xl" style="color:#ffffff !important;"></i>
                        </div>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm text-gray-500">Đã thanh toán</p>
                            <p class="text-2xl font-bold text-emerald-600">@paidCount</p>
                        </div>
                        <div class="p-3 bg-emerald-600 rounded-xl">
                            <i class="fas fa-check-circle text-2xl" style="color:#ffffff !important;"></i>
                        </div>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm text-gray-500">Chờ xác nhận</p>
                            <p class="text-2xl font-bold text-blue-600">@pendingCount</p>
                        </div>
                        <div class="p-3 bg-blue-600 rounded-xl">
                            <i class="fas fa-hourglass-half text-xl" style="color:#ffffff !important;"></i>
                        </div>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm text-gray-500">Chưa thanh toán</p>
                            <p class="text-2xl font-bold text-amber-600">@unpaidCount</p>
                        </div>
                        <div class="p-3 bg-amber-500 rounded-xl">
                            <i class="fas fa-clock text-xl" style="color:#ffffff !important;"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- List -->
            <div class="grid grid-cols-1 gap-6">
                @foreach (var item in list)
                {
                    var cancelled = bookingStatusKey(item) == "cancelled";

                    var payKey = paymentStatusKey(item);
                    var paid = payKey == "paid";
                    var pendingPay = payKey == "pending";
                    var refunded = payKey == "refunded";

                    var dep = item.DepositAmount;

                    var preItems = item.PreOrderItems ?? new List<SmartTable.Models.ViewModels.BookingHistoryItemViewModel.PreOrderItemVm>();
                    var preOrderTotal = item.PreOrderTotalAmount;

                    if (preOrderTotal <= 0m && preItems.Any())
                    {
                        preOrderTotal = preItems.Sum(x => x.UnitPrice * x.Quantity);
                    }

                    var totalAmount = dep + preOrderTotal;

                    var bsKey = bookingStatusKey(item);
                    var bsLabel = bookingStatusLabel(item);

                    string bookingBadgeClass = "bg-gray-100 text-gray-800";
                    string bookingIcon = "fa-clock";

                    if (cancelled) { bookingBadgeClass = "bg-gradient-to-r from-red-500 to-red-600 text-white"; bookingIcon = "fa-times-circle"; }
                    else if (bsKey == "paid") { bookingBadgeClass = "bg-gradient-to-r from-emerald-500 to-emerald-600 text-white"; bookingIcon = "fa-check-circle"; }
                    else if (bsKey == "deposited") { bookingBadgeClass = "bg-gradient-to-r from-gray-700 to-gray-800 text-white"; bookingIcon = "fa-bookmark"; }
                    else if (bsKey == "confirmed") { bookingBadgeClass = "bg-gradient-to-r from-blue-500 to-blue-600 text-white"; bookingIcon = "fa-check-double"; }
                    else if (bsKey == "booked") { bookingBadgeClass = "bg-gradient-to-r from-gray-700 to-gray-800 text-white"; bookingIcon = "fa-bookmark"; }

                    string payBadgeClass = "bg-amber-100 text-amber-700";
                    string payIcon = "fa-clock";
                    if (refunded) { payBadgeClass = "bg-purple-100 text-purple-700"; payIcon = "fa-undo"; }
                    else if (paid) { payBadgeClass = "bg-emerald-100 text-emerald-700"; payIcon = "fa-check-circle"; }
                    else if (pendingPay) { payBadgeClass = "bg-blue-100 text-blue-700"; payIcon = "fa-hourglass-half"; }

                    var payMethod = paymentMethodLabel(item);
                    var special = norm(item.SpecialRequest);

                    <div class="group bg-white rounded-2xl shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300 overflow-hidden">
                        <div class="p-6 border-b border-gray-100">
                            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                                <div class="flex items-center gap-3">
                                    <div class="relative">
                                        <div class="absolute -inset-1 bg-gradient-to-r from-blue-500 to-purple-600 rounded-xl opacity-20 blur"></div>
                                        <div class="relative px-4 py-2 bg-gradient-to-r from-blue-600 to-blue-700 text-white font-bold rounded-xl flex items-center gap-2">
                                            <i class="fas fa-hashtag text-yellow-300"></i>
                                            @item.BookingId
                                        </div>
                                    </div>

                                    <div class="flex flex-wrap gap-2">
                                        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold @bookingBadgeClass">
                                            <i class="fas @bookingIcon"></i>
                                            @bsLabel
                                        </span>

                                        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold @payBadgeClass">
                                            <i class="fas @payIcon"></i>
                                            @paymentStatusLabel(item)
                                        </span>
                                    </div>
                                </div>

                                <div class="text-right">
                                    <p class="text-sm text-gray-500">Thời gian đặt</p>
                                    <p class="font-semibold text-gray-800">
                                    <p class="font-semibold text-gray-800">@((item.CreatedAt ?? item.BookingTime).ToString("HH:mm dd/MM/yyyy"))</p>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="p-6">
                            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                                <div class="lg:col-span-2">
                                    <div class="flex flex-col sm:flex-row gap-5">
                                        <div class="flex-shrink-0">
                                            <img src="@safeImg(item.RestaurantImage)"
                                                 alt="@item.RestaurantName"
                                                 class="w-28 h-28 rounded-2xl object-cover shadow-md border border-gray-200" />
                                        </div>

                                        <div class="flex-1">
                                            <h3 class="text-xl font-bold text-gray-900 mb-2">@item.RestaurantName</h3>

                                            @if (!string.IsNullOrWhiteSpace(item.RestaurantAddress))
                                            {
                                                <div class="flex items-start gap-2 mb-4">
                                                    <i class="fas fa-map-marker-alt"
                                                       style="color:#e11d48 !important; margin-top:0.25rem;"></i>
                                                    <p class="text-gray-600">@item.RestaurantAddress</p>
                                                </div>
                                            }

                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                                <div class="bg-gray-50 rounded-xl p-4">
                                                    <div class="flex items-center gap-3">
                                                        <div class="p-2 bg-blue-600 rounded-lg">
                                                            <i class="fas fa-users" style="color:#ffffff !important;"></i>
                                                        </div>
                                                        <div>
                                                            <p class="text-sm text-gray-500">Số khách</p>
                                                            <p class="text-lg font-semibold text-gray-900">@item.NumberOfGuests người</p>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="bg-gray-50 rounded-xl p-4">
                                                    <div class="flex items-center gap-3">
                                                        <div class="p-2 bg-red-600 rounded-lg">
                                                            <i class="fas fa-coins" style="color:#ffffff !important;"></i>
                                                        </div>
                                                        <div class="w-full">
                                                            <p class="text-sm text-gray-500">Tổng tiền (cọc + đặt trước)</p>
                                                            <div class="flex items-center justify-between gap-3">
                                                                <p class="text-lg font-bold text-red-600">@money(totalAmount)</p>
                                                                <span class="text-xs text-gray-500">@payMethod</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3">
                                                <div class="bg-white border border-gray-200 rounded-xl p-3">
                                                    <p class="text-xs text-gray-500">Tiền cọc</p>
                                                    <p class="font-semibold text-gray-900">@money(dep)</p>
                                                </div>
                                                <div class="bg-white border border-gray-200 rounded-xl p-3">
                                                    <p class="text-xs text-gray-500">Món đặt trước</p>
                                                    <p class="font-semibold text-gray-900">@money(preOrderTotal)</p>
                                                </div>
                                                <div class="bg-white border border-gray-200 rounded-xl p-3">
                                                    <p class="text-xs text-gray-500">Phương thức</p>
                                                    <p class="font-semibold text-gray-900">@payMethod</p>
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(special))
                                            {
                                                <div class="mt-4 p-4 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl border border-blue-100">
                                                    <div class="flex items-start gap-3">
                                                        <i class="fas fa-sticky-note text-blue-500 mt-1"></i>
                                                        <div>
                                                            <p class="text-sm font-medium text-gray-700 mb-1">Ghi chú</p>
                                                            <p class="text-gray-600 whitespace-pre-line">@special</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            @if (preItems.Any() || preOrderTotal > 0m)
                                            {
                                                <div class="mt-4 p-4 bg-gray-50 rounded-xl border border-gray-200">
                                                    <p class="text-sm font-semibold text-gray-800 mb-2">
                                                        <i class="fas fa-utensils mr-2 text-amber-700 bg-amber-500 p-1.5 rounded-md"></i>
                                                        Món đặt trước
                                                    </p>

                                                    @if (preItems.Any())
                                                    {
                                                        <ul class="list-disc list-inside space-y-1 text-gray-700 text-sm">
                                                            @foreach (var p in preItems)
                                                            {
                                                                <li>
                                                                    <span class="font-medium">@p.Name</span>
                                                                    <span class="text-gray-500"> × @p.Quantity</span>
                                                                    <span class="text-gray-500"> — @money(p.UnitPrice)</span>
                                                                </li>
                                                            }
                                                        </ul>
                                                    }
                                                    else
                                                    {
                                                        <p class="text-sm text-gray-500">Chưa có chi tiết món.</p>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="space-y-3">
                                    <a href="@Url.Action("RestaurantDetails", "Home", new { id = item.RestaurantId })" class="block w-full">
                                        <div class="flex items-center justify-center gap-3 px-4 py-3.5 bg-gradient-to-r from-gray-50 to-gray-100 text-gray-800 font-semibold rounded-xl border border-gray-200 hover:border-blue-400 hover:from-blue-50 hover:to-blue-50 hover:text-blue-600 transition-all duration-300">
                                            <i class="fas fa-store-alt text-2xl font-bold" style="color:#1e40af !important;"></i>
                                            <span>Chi tiết nhà hàng</span>
                                        </div>
                                    </a>

                                    @if (!paid && !cancelled && !pendingPay && !refunded)
                                    {
                                        <a href="@Url.Action("Checkout", "ThanhToan", new { bookingId = item.BookingId })" class="block w-full">
                                            <div class="flex items-center justify-center gap-3 px-4 py-3.5 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-semibold rounded-xl shadow-md hover:shadow-lg hover:from-emerald-600 hover:to-emerald-700 transition-all duration-300">
                                                <i class="fas fa-credit-card text-lg text-white"></i>
                                                <span>Thanh toán</span>
                                            </div>
                                        </a>
                                    }
                                    else if (pendingPay && !paid && !cancelled)
                                    {
                                        <button type="button"
                                                class="w-full flex items-center justify-center gap-3 px-4 py-3.5 bg-blue-50 text-blue-700 font-semibold rounded-xl border border-blue-200 cursor-not-allowed">
                                            <i class="fas fa-hourglass-half"></i>
                                            <span>Đang chờ xác nhận thanh toán</span>
                                        </button>
                                    }

                                    <button type="button"
                                            class="w-full flex items-center justify-center gap-3 px-4 py-3.5 @(paid ? "bg-gradient-to-r from-indigo-500 to-indigo-600 text-white shadow-md hover:shadow-lg hover:from-indigo-600 hover:to-indigo-700" : "bg-white text-gray-800 border border-gray-300 hover:bg-gray-50") font-semibold rounded-xl transition-all duration-300"
                                            onclick="openTicketModal(@item.BookingId)">
                                        <i class="fas @(paid ? "fa-file-invoice text-white" : "fa-receipt text-gray-700") text-lg"></i>
                                        <span>@(paid ? "Xem phiếu đặt bàn" : "Xem thông tin đặt bàn")</span>
                                    </button>

                                    @if (!paid && !cancelled && item.BookingTime > DateTime.Now)
                                    {
                                        using (Html.BeginForm("HuyDatBan", "DatBan", FormMethod.Post, new { @class = "w-full" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("bookingId", item.BookingId)

                                            <button type="submit"
                                                    onclick="return confirm('Bạn chắc chắn muốn hủy đặt bàn #@item.BookingId không?');"
                                                    class="w-full flex items-center justify-center gap-3 px-4 py-3.5 bg-gradient-to-r from-red-500 to-red-600 text-white font-semibold rounded-xl shadow-md hover:shadow-lg hover:from-red-600 hover:to-red-700 transition-all duration-300">
                                                <i class="fas fa-times-circle text-lg text-white"></i>
                                                <span>Hủy đặt bàn</span>
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="ticket-content-@item.BookingId" class="hidden">
                        <div class="p-6">
                            <h2 class="text-2xl font-bold text-gray-900 text-center mb-4">Phiếu đặt bàn</h2>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm text-gray-800 mb-4">
                                <p><strong>Mã đặt bàn:</strong> #@item.BookingId</p>
                                <p><strong>Thời gian:</strong> @item.BookingTime.ToString("dd/MM/yyyy HH:mm")</p>

                                <p><strong>Tên khách hàng:</strong> @(string.IsNullOrWhiteSpace(item.CustomerName) ? "Khách hàng" : item.CustomerName)</p>
                                <p><strong>Số điện thoại:</strong> @(string.IsNullOrWhiteSpace(item.CustomerPhone) ? "-" : item.CustomerPhone)</p>

                                <p><strong>Nhà hàng:</strong> @item.RestaurantName</p>
                                <p><strong>Địa chỉ:</strong> @item.RestaurantAddress</p>

                                <p><strong>Số lượng khách:</strong> @item.NumberOfGuests</p>
                                <p><strong>Trạng thái:</strong> @bookingStatusLabel(item)</p>

                                <p class="md:col-span-2">
                                    <strong>Ghi chú:</strong>
                                    @(string.IsNullOrWhiteSpace(special) ? "Không có" : special)
                                </p>
                            </div>

                            <table class="w-full text-sm border border-gray-200 mt-2">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="py-2 px-3 text-left">Hạng mục</th>
                                        <th class="py-2 px-3 text-center">Số lượng</th>
                                        <th class="py-2 px-3 text-right">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="border-t">
                                        <td class="py-2 px-3">Tiền cọc / phí giữ chỗ</td>
                                        <td class="py-2 px-3 text-center">@item.NumberOfGuests người</td>
                                        <td class="py-2 px-3 text-right">@money(dep)</td>
                                    </tr>

                                    @if (preItems.Any() || preOrderTotal > 0m)
                                    {
                                        if (preItems.Any())
                                        {
                                            foreach (var p in preItems)
                                            {
                                                <tr class="border-t">
                                                    <td class="py-2 px-3">@p.Name</td>
                                                    <td class="py-2 px-3 text-center">@p.Quantity</td>
                                                    <td class="py-2 px-3 text-right">@money(p.UnitPrice * p.Quantity)</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr class="border-t">
                                                <td class="py-2 px-3">Món đặt trước</td>
                                                <td class="py-2 px-3 text-center">—</td>
                                                <td class="py-2 px-3 text-right">@money(preOrderTotal)</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>

                            <div class="flex justify-end mt-3 text-sm">
                                <strong>Tổng tiền:&nbsp;</strong>
                                <span class="font-semibold">@money(totalAmount)</span>
                            </div>

                            <div class="mt-4 text-sm">
                                <p><strong>Trạng thái thanh toán:</strong> <span class="font-semibold">@paymentStatusLabel(item)</span></p>
                                <p><strong>Phương thức:</strong> <span class="font-semibold">@payMethod</span></p>
                            </div>

                            <div class="mt-5 text-xs text-gray-600 leading-relaxed border-t pt-4">
                                <p class="font-semibold mb-1">Lưu ý:</p>
                                <p>• Nếu cần hỗ trợ, vui lòng liên hệ hotline: <b>0941326591</b>.</p>
                                <p>• Trường hợp muốn <b>hủy đặt bàn</b>, vui lòng <b>liên hệ trực tiếp nhà hàng</b> để được hỗ trợ nhanh nhất.</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div id="ticket-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black bg-opacity-50 p-4">
    <div class="bg-white rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl relative">
        <button type="button"
                onclick="closeTicketModal()"
                class="absolute top-3 right-3
               w-8 h-8 rounded-full
               bg-gray-100
               flex items-center justify-center
               text-gray-500
               hover:bg-red-500 hover:text-red-500
               transition-colors duration-150">
            <i class="fas fa-times"></i>
        </button>

        <div id="ticket-modal-body"></div>
    </div>
</div>

@section Scripts {
    <script>
        function openTicketModal(id) {
            const modal = document.getElementById('ticket-modal');
            const body = document.getElementById('ticket-modal-body');
            const template = document.getElementById('ticket-content-' + id);
            if (!template) return;

            body.innerHTML = template.innerHTML;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeTicketModal() {
            const modal = document.getElementById('ticket-modal');
            const body = document.getElementById('ticket-modal-body');
            body.innerHTML = '';
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }

        document.getElementById('ticket-modal').addEventListener('click', function (e) {
            if (e.target.id === 'ticket-modal') closeTicketModal();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeTicketModal();
        });
    </script>
}
