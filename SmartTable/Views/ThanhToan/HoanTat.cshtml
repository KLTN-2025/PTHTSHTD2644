@model SmartTable.Models.ViewModels.PaymentViewModel
@{
    ViewBag.Title = "Hoàn tất đặt bàn";
}

<div class="max-w-xl mx-auto mt-12 bg-white rounded-2xl shadow-lg p-8 text-center">
    <div class="w-16 h-16 mx-auto mb-4 flex items-center justify-center rounded-full bg-green-100 text-green-600">
        <i class="fas fa-check text-2xl"></i>
    </div>
    <h1 class="text-2xl font-bold mb-2 text-gray-800">Đặt bàn thành công!</h1>

    <p class="text-gray-600 mb-4">
        Cảm ơn bạn đã đặt bàn tại <span class="font-semibold">@Model.RestaurantName</span>.
    </p>

    <div class="bg-gray-50 rounded-xl p-4 text-sm text-left inline-block mx-auto mb-4">
        <p><span class="font-semibold">Thời gian:</span> @Model.BookingTime.ToString("dd/MM/yyyy HH:mm")</p>
        <p><span class="font-semibold">Số khách:</span> @Model.NumberOfGuests</p>
        <p><span class="font-semibold">Tổng tiền:</span> @Model.Amount.ToString("N0") đ</p>
        <p><span class="font-semibold">Hình thức thanh toán:</span> @Model.PaymentMethod</p>
        <p><span class="font-semibold">Trạng thái:</span> @Model.Status</p>
    </div>

    <a href="@Url.Action("Index", "Home")"
       class="mt-2 inline-block px-6 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition">
        Về trang chủ
    </a>
</div>
