@model SmartTable.Models.ViewModels.PaymentViewModel

@{
    ViewBag.Title = "Hoàn tất đặt bàn";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int bookingId = 0;
    string restaurantName = "Nhà hàng";
    DateTime bookingTime = DateTime.Now;
    int numberOfGuests = 0;
    decimal amount = 0m;
    string paymentMethod = "Chuyển khoản";
    string status = "Thành công";

    if (Model != null)
    {
        bookingId = Model.BookingId;
        restaurantName = string.IsNullOrWhiteSpace(Model.RestaurantName)
                            ? "Nhà hàng"
                            : Model.RestaurantName;

        bookingTime = Model.BookingTime;
        numberOfGuests = Model.NumberOfGuests;
        amount = Model.Amount;
        paymentMethod = string.IsNullOrWhiteSpace(Model.PaymentMethod)
                            ? "Chuyển khoản"
                            : Model.PaymentMethod;
        status = string.IsNullOrWhiteSpace(Model.Status)
                            ? "Thành công"
                            : Model.Status;
    }

    // ===== FIX: đánh dấu trạng thái thành công / không =====
    bool isSuccessStatus = false;
    if (!string.IsNullOrEmpty(status))
    {
        var s = status.ToLowerInvariant();
        // check tiếng Việt & tiếng Anh
        isSuccessStatus = s.Contains("thành công") || s.Contains("success");
    }
}


<div class="bg-gray-50 min-h-screen py-10">
    <div class="container mx-auto max-w-3xl px-4">

        <!-- Bước tiến trình -->
        <div class="flex justify-center mb-8">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2 text-gray-400">
                    <span class="w-8 h-8 rounded-full border-2 border-gray-300 flex items-center justify-center font-bold">1</span>
                    <span class="text-xs md:text-sm">Đặt bàn</span>
                </div>
                <div class="w-12 h-0.5 bg-gray-300"></div>
                <div class="flex items-center gap-2 text-gray-400">
                    <span class="w-8 h-8 rounded-full border-2 border-gray-300 flex items-center justify-center font-bold">2</span>
                    <span class="text-xs md:text-sm">Thanh toán cọc</span>
                </div>
                <div class="w-12 h-0.5 bg-green-500"></div>
                <div class="flex items-center gap-2 text-green-600 font-bold">
                    <span class="w-8 h-8 rounded-full bg-green-600 text-white flex items-center justify-center">3</span>
                    <span class="text-xs md:text-sm">Hoàn tất</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-lg p-8 text-center border border-gray-100">
            <div class="w-20 h-20 mx-auto mb-4 flex items-center justify-center rounded-full bg-green-100 text-green-600">
                <i class="fas fa-check text-3xl"></i>
            </div>

            <h1 class="text-2xl md:text-3xl font-bold mb-2 text-gray-800">
                Đặt bàn thành công!
            </h1>

            <p class="text-gray-600 mb-4 text-sm md:text-base">
                Cảm ơn bạn đã đặt bàn tại
                <span class="font-semibold">@restaurantName</span>.
            </p>

            @if (bookingId > 0)
            {
                <p class="text-xs text-gray-400 mb-2">
                    Mã đặt bàn:
                    <span class="font-mono font-semibold text-gray-700">#@bookingId</span>
                </p>
            }

        <div class="bg-gray-50 rounded-xl p-4 md:p-5 text-sm text-left inline-block mx-auto mb-5 border border-gray-100">
            <p class="mb-1">
                <span class="font-semibold text-gray-700">Thời gian:</span>
                <span class="text-gray-800">
                    @bookingTime.ToString("HH:mm - dd/MM/yyyy")
                </span>
            </p>
            <p class="mb-1">
                <span class="font-semibold text-gray-700">Số khách:</span>
                <span class="text-gray-800">
                    @numberOfGuests người
                </span>
            </p>
            <p class="mb-1">
                <span class="font-semibold text-gray-700">Tiền cọc đã thanh toán:</span>
                <span class="text-red-600 font-semibold">
                    @amount.ToString("#,##0") đ
                </span>
            </p>
            <p class="mb-1">
                <span class="font-semibold text-gray-700">Hình thức thanh toán:</span>
                <span class="text-gray-800">
                    @paymentMethod
                </span>
            </p>
            <p class="mb-1">
                <span class="font-semibold text-gray-700">Trạng thái:</span>
                <span class="@(isSuccessStatus
                   ? "text-green-600 font-semibold"
                   : "text-yellow-600 font-semibold")">
                    @status
                </span>
            </p>

        </div>

            <p class="text-xs md:text-sm text-gray-500 mb-6">
                Vui lòng giữ lại mã đặt bàn hoặc kiểm tra email/tin nhắn xác nhận từ SmartTable.
                Đến nhà hàng, bạn chỉ cần cung cấp mã <span class="font-mono font-semibold">#@bookingId</span> để được hỗ trợ nhanh hơn.
            </p>

            <div class="flex flex-col sm:flex-row gap-3 justify-center">
                <a href="@Url.Action("DanhSachBanDaDat", "DATBAN")"
                   class="px-6 py-2.5 bg-white border border-gray-300 text-gray-800 rounded-lg text-sm font-semibold hover:bg-gray-50 transition">
                    Xem lịch sử đặt bàn
                </a>

                <a href="@Url.Action("Index", "Home")"
                   class="px-6 py-2.5 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition">
                    Về trang chủ
                </a>
            </div>
        </div>
    </div>
</div>
