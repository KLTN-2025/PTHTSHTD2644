@using System
@using System.Linq
@using System.Collections.Generic
@using System.Globalization
@model IEnumerable<SmartTable.Models.ViewModels.BusinessBookingItemViewModel>

@{
    ViewBag.Title = "Quản lý đặt bàn";
    Layout = "~/Views/Shared/_BusinessLayout.cshtml";

    string statusFilter = (Request["statusFilter"] ?? (ViewBag.StatusFilter as string) ?? "").Trim();
    string q = (Request["q"] ?? "").Trim().Replace("#", "");
    string sort = (Request["sort"] ?? "desc").Trim().ToLowerInvariant(); 

    var data = Model ?? Enumerable.Empty<SmartTable.Models.ViewModels.BusinessBookingItemViewModel>();

    if (!string.IsNullOrWhiteSpace(statusFilter))
    {
        data = data.Where(x =>
            !string.IsNullOrWhiteSpace(x.BookingStatus) &&
            string.Equals(x.BookingStatus.Trim(), statusFilter, StringComparison.OrdinalIgnoreCase));
    }

    if (!string.IsNullOrWhiteSpace(q))
    {
        data = data.Where(x => x.BookingId.ToString().Contains(q));
    }

    data = (sort == "asc") ? data.OrderBy(x => x.BookingId) : data.OrderByDescending(x => x.BookingId);
    var viewData = data.ToList();

    bool hasFilter =
        !string.IsNullOrWhiteSpace(q) ||
        !string.IsNullOrWhiteSpace(statusFilter) ||
        !string.Equals(sort, "desc", StringComparison.OrdinalIgnoreCase);

    Func<decimal, string> money = v => string.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:n0} đ", v);
}

<div class="bg-gray-50 min-h-screen py-8">
    <div class="container mx-auto max-w-6xl px-4">

        <a href="@Url.Action("Index", "BusinessHome")"
           class="inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-lg border border-gray-300 text-gray-700 bg-white hover:bg-gray-100 transition">
            <i class="fas fa-arrow-left mr-1"></i> Quay lại Dashboard
        </a>

        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6 mt-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Quản lý đặt bàn</h1>
                <p class="text-sm text-gray-500 mt-1">Hiển thị cọc, món đặt trước và hoàn cọc.</p>
            </div>

            <form method="get" action="@Url.Action("Index","BusinessBookings")" class="flex flex-wrap items-center gap-2">
                <div class="relative">
                    <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                        <i class="fas fa-search text-xs" style="color:#111827 !important;" aria-hidden="true"></i>
                    </span>
                    <input type="text"
                           name="q"
                           value="@q"
                           placeholder="Tìm theo mã (#123...)"
                           class="w-56 border border-gray-300 rounded-lg pl-9 pr-3 py-1.5 text-sm text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-blue-200 focus:border-blue-400" />
                </div>

                <select name="statusFilter" class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm text-gray-700 bg-white">
                    <option value="" @(string.IsNullOrWhiteSpace(statusFilter) ? "selected" : "")>Tất cả trạng thái</option>
                    <option value="Đã đặt" @(statusFilter == "Đã đặt" ? "selected" : "")>Đã đặt</option>
                    <option value="Đã cọc thành công" @(statusFilter == "Đã cọc thành công" ? "selected" : "")>Đã cọc thành công</option>
                    <option value="Đã hủy" @(statusFilter == "Đã hủy" ? "selected" : "")>Đã hủy</option>
                </select>

                <select name="sort" class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm text-gray-700 bg-white">
                    <option value="desc" @(sort == "desc" ? "selected" : "")>Mã: Mới → Cũ</option>
                    <option value="asc" @(sort == "asc" ? "selected" : "")>Mã: Cũ → Mới</option>
                </select>

                <button type="submit" class="px-3 py-1.5 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700">
                    Áp dụng
                </button>

                @if (hasFilter)
                {
                    <a href="@Url.Action("Index", "BusinessBookings")"
                       class="px-3 py-1.5 bg-white text-gray-700 rounded-lg text-sm border border-gray-300 hover:bg-gray-100">
                        Xóa lọc
                    </a>
                }
            </form>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-4 px-4 py-3 rounded-lg bg-green-50 border border-green-200 text-green-800 text-sm flex items-center gap-2">
                <i class="fas fa-check-circle"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-800 text-sm flex items-center gap-2">
                <i class="fas fa-exclamation-triangle"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <table class="min-w-full text-sm">
                <thead class="bg-gray-100 text-gray-700 uppercase text-xs">
                    <tr>
                        <th class="px-4 py-3 text-left">Mã</th>
                        <th class="px-4 py-3 text-left">Nhà hàng</th>
                        <th class="px-4 py-3 text-left">Khách</th>
                        <th class="px-4 py-3 text-left">Thời gian</th>
                        <th class="px-4 py-3 text-center">Số khách</th>
                        <th class="px-4 py-3 text-left">Trạng thái</th>
                        <th class="px-4 py-3 text-left">Cọc / Món</th>
                        <th class="px-4 py-3 text-center">Thao tác</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-gray-100">
                    @if (viewData != null && viewData.Any())
                    {
                        foreach (var item in viewData)
                        {
                            var bookingStatus = (item.BookingStatus ?? "").Trim();
                            var paymentStatus = (item.PaymentStatus ?? "").Trim();

                            bool isCanceled =
                                bookingStatus.IndexOf("hủy", StringComparison.OrdinalIgnoreCase) >= 0 ||
                                bookingStatus.IndexOf("cancel", StringComparison.OrdinalIgnoreCase) >= 0;

                            bool hasPre = item.HasPreOrder && item.PreOrderItems != null && item.PreOrderItems.Any();

                            decimal expectedDeposit = item.DepositAmount ?? 0m;
                            decimal depositNet = item.DepositPaidAmount; 
                            bool depositPaid = depositNet > 0m;

                            bool depositRefunded =
                                paymentStatus.IndexOf("hoàn cọc", StringComparison.OrdinalIgnoreCase) >= 0 ||
                                paymentStatus.IndexOf("đã hoàn", StringComparison.OrdinalIgnoreCase) >= 0 ||
                                paymentStatus.IndexOf("refund", StringComparison.OrdinalIgnoreCase) >= 0;

                            bool canConfirmDeposit = (!isCanceled) && (!depositPaid) && (!depositRefunded);

                            bool canCancelBeforeTime = (!isCanceled) && (item.BookingTime > DateTime.Now);
                            bool canCancelBeforePay = canCancelBeforeTime && (!depositPaid);

                            bool canRefund = depositPaid && (!depositRefunded) && (!hasPre);

                            string badgeClass =
                                isCanceled ? "bg-red-50 text-red-700" :
                                depositRefunded ? "bg-gray-100 text-gray-600" :
                                depositPaid ? "bg-green-50 text-green-700" :
                                "bg-yellow-50 text-yellow-700";

                            decimal preorderValue = item.PreOrderTotalAmount;
                            decimal totalPaidDisplay = item.TotalCustomerPaidAmount;

                            var refundUrl = Url.Action("Index", "Refund", new { bookingId = item.BookingId, returnUrl = Request.RawUrl });

                            <tr class="hover:bg-gray-50 align-top">
                                <td class="px-4 py-3">
                                    <div class="font-semibold text-gray-800">#@item.BookingId</div>
                                    <div class="text-xs text-gray-500 mt-1">
                                        Tổng khách đã gửi: <b class="text-gray-900">@money(totalPaidDisplay)</b>
                                    </div>
                                </td>

                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-3">
                                        <img src="@(string.IsNullOrWhiteSpace(item.RestaurantImage) ? "https://via.placeholder.com/96x96?text=IMG" : item.RestaurantImage)"
                                             class="w-12 h-12 rounded-lg object-cover border border-gray-200" />
                                        <div>
                                            <div class="font-semibold text-gray-800">@item.RestaurantName</div>
                                            @if (!string.IsNullOrWhiteSpace(item.RestaurantAddress))
                                            {
                                                <div class="text-xs text-gray-500">
                                                    <i class="fas fa-map-marker-alt mr-1" style="color:#dc2626 !important;"></i>
                                                    @item.RestaurantAddress
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td class="px-4 py-3">
                                    <div class="font-medium text-gray-800">@item.CustomerName</div>
                                    @if (!string.IsNullOrWhiteSpace(item.CustomerPhone))
                                    {
                                        <div class="text-xs text-gray-500 flex items-center gap-1">
                                            <i class="fas fa-phone-alt" style="color:#2563eb !important; font-size:10px;"></i>
                                            <span>@item.CustomerPhone</span>
                                        </div>
                                    }
                                </td>

                                <td class="px-4 py-3">
                                    <div class="text-gray-800 font-medium">@item.BookingTime.ToString("HH:mm dd/MM/yyyy")</div>
                                </td>

                                <td class="px-4 py-3 text-center">
                                    <span class="inline-flex items-center justify-center px-2 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold">
                                        @item.NumberOfGuests người
                                    </span>
                                </td>

                                <td class="px-4 py-3">
                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold @badgeClass">
                                        @(string.IsNullOrWhiteSpace(item.BookingStatus) ? "Chờ xác nhận" : item.BookingStatus)
                                    </span>

                                    @if (!string.IsNullOrWhiteSpace(item.SpecialRequest))
                                    {
                                        <div class="mt-2 text-xs text-gray-600">
                                            <span class="font-semibold">Ghi chú:</span> @item.SpecialRequest
                                        </div>
                                    }

                                    @if (isCanceled && !string.IsNullOrWhiteSpace(item.CancelReason))
                                    {
                                        <div class="mt-2 text-xs text-red-600">
                                            <span class="font-semibold">Lý do hủy:</span> @item.CancelReason
                                        </div>
                                    }
                                </td>

                                <td class="px-4 py-3">
                                    <div class="text-xs text-gray-500">Trạng thái cọc:</div>
                                    <div class="font-semibold text-gray-800">
                                        @(string.IsNullOrWhiteSpace(item.PaymentStatus) ? "Chưa ghi nhận" : item.PaymentStatus)
                                    </div>

                                    <div class="mt-2 text-xs text-gray-700">
                                        Phí giữ chỗ: <b>@money(expectedDeposit)</b>
                                    </div>
                                    <div class="text-xs text-gray-700">
                                        Đã nhận: <b>@money(depositNet)</b>
                                    </div>

                                    @if (hasPre)
                                    {
                                        <div class="mt-3 text-xs font-semibold text-amber-700 bg-amber-50 inline-flex px-2 py-1 rounded-lg">
                                            <i class="fas fa-utensils mr-1"></i> Món đặt trước: @money(preorderValue)
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-3 text-xs text-gray-400 italic">Không có món đặt trước</div>

                                        if (canRefund)
                                        {
                                            <div class="mt-1 text-[11px] text-amber-700 bg-amber-50 inline-flex px-2 py-1 rounded-lg border border-amber-100">
                                                Đã cọc + không có món → có thể hoàn cọc
                                            </div>
                                        }
                                    }
                                </td>

                                <td class="px-4 py-3 text-center">

                                    @if (canConfirmDeposit)
                                    {
                                        <form action="@Url.Action("ConfirmPayment","BusinessBookings")" method="post" class="inline-block mb-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@item.BookingId" />
                                            <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded-lg font-semibold">
                                                Xác nhận đã nhận cọc
                                            </button>
                                        </form>

                                        if (canCancelBeforePay)
                                        {
                                            <form id="cancelForm-@item.BookingId"
                                                  action="@Url.Action("CancelBooking","BusinessBookings")"
                                                  method="post"
                                                  class="inline-block">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@item.BookingId" />
                                                <input type="hidden" name="cancelReason" value="" />

                                                <button type="button"
                                                        onclick="openCancelPrompt(@item.BookingId)"
                                                        class="mt-1 px-3 py-1.5 bg-red-600 text-white text-xs font-semibold rounded-lg hover:bg-red-700 shadow-sm">
                                                    Hủy đặt bàn
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <div class="mt-1 text-[11px] text-gray-400 italic">Đã qua thời gian hủy</div>
                                        }
                                    }
                                    else
                                    {
                                        if (canRefund)
                                        {
                                            <a href="@refundUrl"
                                               class="inline-flex items-center justify-center px-3 py-2 bg-amber-500 text-white text-xs font-semibold rounded-lg hover:bg-amber-600 shadow-sm">
                                                Hoàn cọc
                                            </a>

                                            <div class="mt-1 text-[11px] text-gray-400 italic">
                                                Hoàn cọc xử lý tại trang Refund
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-gray-400 italic">Đã xử lý</span>
                                        }
                                    }

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="px-4 py-6 text-center text-gray-500 text-sm">
                                Chưa có đặt bàn nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function openCancelPrompt(bookingId) {
            var reason = prompt("Nhập lý do hủy bàn:");
            if (reason === null) return;

            reason = (reason || "").trim();
            if (!reason) {
                alert("Vui lòng nhập lý do hủy.");
                return;
            }

            var form = document.getElementById("cancelForm-" + bookingId);
            if (!form) return;

            var input = form.querySelector("input[name='cancelReason']");
            if (input) input.value = reason;

            form.submit();
        }
    </script>
}
