@model SmartTable.Models.ViewModels.RestaurantFilterViewModel
@using System
@using System.Linq
@using System.Collections.Generic

@{
    ViewBag.Title = "Kết quả tìm kiếm - Đặt bàn nhà hàng";

    var results = Model?.Results ?? Enumerable.Empty<SmartTable.Models.Restaurants>();
    var total = results.Count();

    var cities = ViewBag.AvailableCities as IEnumerable<string> ?? Enumerable.Empty<string>();
    var areas = ViewBag.AvailableAreas as IEnumerable<string> ?? Enumerable.Empty<string>();

    var sortBy = "";
    try
    {
        sortBy = (ViewBag.SortBy ?? Request["SortBy"] ?? "").ToString();
    }
    catch { sortBy = ""; }
}

<div class="max-w-7xl mx-auto space-y-8 px-4 md:px-8">

    <!-- Header -->
    <section class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 bg-white p-4 md:p-6 rounded-xl shadow border border-gray-100">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-gray-900">Kết quả lọc</h1>
            <p class="text-sm text-gray-600">Tìm thấy @total điểm đến</p>
        </div>

        @*<div class="flex items-center gap-3">
            <label class="text-sm text-gray-600 whitespace-nowrap">Sắp xếp:</label>
            <select name="SortBy" form="filterForm"
                    class="text-sm text-gray-700 border border-gray-300 rounded-lg px-3 py-2 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="" @(string.IsNullOrWhiteSpace(sortBy) ? "selected" : "")>Mặc định</option>
                <option value="Discount" @(sortBy == "Discount" ? "selected" : "")>Mức ưu đãi</option>
                <option value="Rating" @(sortBy == "Rating" ? "selected" : "")>Đánh giá</option>
                <option value="Name" @(sortBy == "Name" ? "selected" : "")>Tên</option>
            </select>
        </div>*@
    </section>

    <!-- Bộ lọc -->
    <section class="bg-white rounded-xl shadow border border-gray-100 p-6 md:p-8">
        @using (Html.BeginForm("Search", "Home", FormMethod.Get, new { @class = "space-y-4", id = "filterForm" }))
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-end">

                <!-- Thành phố -->
                <div class="space-y-1">
                    <label class="block text-xs font-semibold text-gray-500 mb-1">Thành phố</label>
                    <select name="City" id="citySelect"
                            class="w-full text-sm border border-gray-300 rounded-lg px-4 py-2 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">Chọn thành phố</option>
                        @foreach (var city in cities)
                        {
                            <option value="@city" @(string.Equals(Model?.City, city, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>
                                @city
                            </option>
                        }
                    </select>
                </div>

                <!-- Khu vực -->
                <div class="space-y-1">
                    <label class="block text-xs font-semibold text-gray-500 mb-1">Khu vực</label>
                    <select name="Area" id="areaSelect"
                            class="w-full text-sm border border-gray-300 rounded-lg px-4 py-2 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">Chọn khu vực</option>
                        @foreach (var area in areas)
                        {
                            <option value="@area" @(string.Equals(Model?.Area, area, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>
                                @area
                            </option>
                        }
                    </select>
                    <p class="text-[11px] text-gray-400" id="areaHint" style="display:none;">Đang tải khu vực...</p>
                </div>


                <div class="flex gap-2 lg:justify-end">
                    <a href="@Url.Action("Search","Home")"
                       class="px-4 py-2 bg-white border border-gray-200 rounded-full font-semibold text-gray-700 hover:bg-gray-100 transition">
                        Xóa lọc
                    </a>
                    <button type="submit"
                            class="px-5 py-2 bg-blue-600 text-white rounded-full font-semibold hover:bg-blue-700 transition">
                        Tìm kiếm
                    </button>
                </div>

            </div>
        }
    </section>

    <section class="space-y-4">
        <div class="flex justify-between items-center">
            <h2 class="text-2xl font-semibold text-gray-900">Kết quả tìm kiếm</h2>
        </div>

        @if (!results.Any())
        {
            <div class="bg-white rounded-xl shadow border border-gray-100 p-8 text-center">
                <p class="text-gray-500">Không tìm thấy nhà hàng nào khớp với bộ lọc của bạn.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var restaurant in results)
                {
                    var img = string.IsNullOrWhiteSpace(restaurant.Image)
                        ? "https://via.placeholder.com/400x300.png?text=SmartTable"
                        : restaurant.Image;

                    var openText = string.IsNullOrWhiteSpace(restaurant.opening_hours)
                        ? "Giờ mở cửa: liên hệ nhà hàng"
                        : restaurant.opening_hours;

                    <a href="@Url.Action("RestaurantDetails", "Home", new { id = restaurant.restaurant_id })"
                       class="block bg-white rounded-xl shadow border border-gray-100 overflow-hidden hover:shadow-lg transition-transform hover:-translate-y-0.5">

                        <div class="h-44 overflow-hidden bg-gray-200">
                            <img class="w-full h-full object-cover"
                                 src="@img"
                                 loading="lazy"
                                 alt="Ảnh nhà hàng @restaurant.name" />
                        </div>

                        <div class="p-4 space-y-2">
                            <h3 class="text-base font-semibold text-gray-900 truncate" title="@restaurant.name">
                                @restaurant.name
                            </h3>

                            <p class="text-xs text-gray-600 flex items-start">
                                <i class="fas fa-map-marker-alt"
                                                                   style="
                                       font-size: 14px;
                                       margin-top: 2px;
                                       color: #ef4444 !important; 
                                   ">
                                </i>
                                <span class="ml-2 line-clamp-2">@restaurant.address</span>
                            </p>

                            <p class="text-xs text-gray-600 flex items-center">
                                <i class="fas fa-clock"
                                       style="
                                       font-size: 14px;
                                       color: #4b5563 !important;
                                   ">
                                </i>

                                <span class="ml-2">@openText</span>
                            </p>
                        </div>

                        <div class="border-t border-gray-200 p-3 bg-gray-50">
                            <span class="block text-center px-4 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-colors">
                                Đặt bàn ngay
                            </span>
                        </div>
                    </a>
                }
            </div>
        }
    </section>

</div>

@section Scripts {
    <script>
        $(function () {
            var $city = $('#citySelect');
            var $area = $('#areaSelect');
            var $hint = $('#areaHint');

            function setLoading(isLoading) {
                if (isLoading) {
                    $area.prop('disabled', true);
                    $hint.show();
                } else {
                    $area.prop('disabled', false);
                    $hint.hide();
                }
            }

            $city.on('change', function () {
                var city = $city.val();

                $area.html('<option value="">Chọn khu vực</option>');
                if (!city) return;

                setLoading(true);

                $.getJSON('@Url.Action("GetAreasByCity", "Home")', { city: city })
                    .done(function (data) {
                        var options = '<option value="">Chọn khu vực</option>';
                        if (data && data.length) {
                            $.each(data, function (i, v) {
                                options += '<option value="' + v + '">' + v + '</option>';
                            });
                        }
                        $area.html(options);
                    })
                    .fail(function () {
                        $area.html('<option value="">Không tải được khu vực</option>');
                    })
                    .always(function () {
                        setLoading(false);
                    });
            });
        });
    </script>
}
