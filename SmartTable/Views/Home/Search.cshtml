@model SmartTable.Models.ViewModels.RestaurantFilterViewModel

@{
    ViewBag.Title = "Kết quả tìm kiếm - Đặt bàn nhà hàng";
}

<div class="max-w-7xl mx-auto space-y-8 px-4 md:px-8">

    <!-- Tiêu đề và Kết quả tìm kiếm -->
    <section class="flex justify-between items-center bg-white p-4 md:p-6 rounded-lg shadow-lg">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-gray-900">Kết quả lọc</h1>
            <p class="text-sm text-gray-600">Tìm thấy @(Model.Results?.Count() ?? 0) điểm đến</p>
        </div>
        <div class="flex items-center gap-3">
            <!-- Sắp xếp -->
            <label class="text-sm text-gray-600">Sắp xếp:</label>
            <select class="text-sm text-gray-600 border-gray-300 rounded-md px-3 py-1.5 bg-gray-50 focus:outline-none focus:ring-1 focus:ring-blue-500">
                <option value="Discount">Mức ưu đãi</option>
                <option value="Rating">Đánh giá</option>
                <option value="Name">Tên</option>
            </select>
        </div>
    </section>

    <!-- Bộ lọc -->
    <section class="bg-white rounded-xl shadow-lg border border-gray-100 p-6 md:p-8">
        @using (Html.BeginForm("Search", "Home", FormMethod.Get, new { @class = "space-y-4" }))
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Thành phố (Dynamic) -->
                <div class="space-y-1">
                    <label class="block text-xs font-semibold text-gray-500 mb-1">Thành phố</label>
                    <select name="City" id="citySelect" class="w-full text-sm border-gray-300 rounded-md px-4 py-2 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">Chọn thành phố</option>
                        @foreach (var city in ViewBag.AvailableCities as List<string>)
                        {
                            <option value="@city" @(Model.City == city ? "selected" : "")>@city</option>
                        }
                    </select>
                </div>

                <!-- Khu vực (Dynamically populated based on selected city) -->
                <div class="space-y-1">
                    <label class="block text-xs font-semibold text-gray-500 mb-1">Khu vực</label>
                    <select name="Area" id="areaSelect" class="w-full text-sm border-gray-300 rounded-md px-4 py-2 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">Chọn khu vực</option>

                        @if (ViewBag.AvailableAreas != null)
                        {
                            foreach (var area in (List<string>)ViewBag.AvailableAreas)
                            {
                                <option value="@area" @(Model.Area == area ? "selected" : "")>@area</option>
                            }
                        }
                    </select>
                </div>

                <!-- Các bộ lọc khác -->
                <!-- ... -->
                <!-- Nút Lọc -->
                <div class="ml-auto">
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition">
                        Tìm kiếm
                    </button>
                </div>
            </div>
        }
    </section>

    <!-- KẾT QUẢ TÌM KIẾM -->
    <section class="space-y-4">
        <div class="flex justify-between items-center">
            <h2 class="text-2xl font-semibold text-gray-900">Kết quả tìm kiếm</h2>
        </div>

        @if (Model?.Results == null || !Model.Results.Any())
        {
            <div class="bg-white rounded-xl shadow-md p-6 text-center">
                <p class="text-gray-500">Không tìm thấy nhà hàng nào khớp với bộ lọc của bạn.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var restaurant in Model.Results)
                {
                    <a href="@Url.Action("RestaurantDetails", "Home", new { id = restaurant.restaurant_id })"
                       class="block bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden hover:shadow-lg transition-transform hover:-translate-y-0.5">
                        <div class="h-44 overflow-hidden bg-gray-200">
                            <img class="w-full h-full object-cover"
                                 src="@(restaurant.Image ?? "https://via.placeholder.com/400x300.png?text=SmartTable")"
                                 alt="Ảnh nhà hàng @restaurant.name" />
                        </div>

                        <div class="p-4 space-y-2">
                            <h3 class="text-base font-semibold text-gray-900 truncate" title="@restaurant.name">
                                @restaurant.name
                            </h3>

                            <p class="text-xs text-gray-600 flex items-start">
                                <i class="fas fa-map-marker-alt text-gray-400 text-sm"></i>
                                <span class="ml-2 line-clamp-2">@restaurant.address</span>
                            </p>

                            <p class="text-xs text-gray-600 flex items-center">
                                <i class="fas fa-clock text-gray-400 text-sm"></i>
                                <span class="ml-2">@restaurant.opening_hours ?? "Giờ mở cửa: liên hệ nhà hàng"</span>
                            </p>
                        </div>

                        <div class="border-t border-gray-200 p-3 bg-gray-50">
                            <span class="block text-center px-4 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-colors">
                                Đặt bàn ngay
                            </span>
                        </div>
                    </a>
                }
            </div>
        }
    </section>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#citySelect').change(function () {
                var city = $(this).val();
                if (city) {
                    $.getJSON('@Url.Action("GetAreasByCity", "Home")', { city: city }, function (data) {
                        var options = '<option value="">Chọn khu vực</option>';
                        $.each(data, function (index, value) {
                            options += '<option value="' + value + '">' + value + '</option>';
                        });
                        $('#areaSelect').html(options);
                    });
                } else {
                    $('#areaSelect').html('<option value="">Chọn khu vực</option>');
                }
            });
        });
    </script>
}
