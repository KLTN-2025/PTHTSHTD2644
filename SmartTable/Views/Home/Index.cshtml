@using System.Globalization
@using System.Linq
@using SmartTable.Models
@model SmartTable.Models.ViewModels.RestaurantFilterViewModel
@{
    ViewBag.Title = "Đặt bàn nhà hàng - SmartTable";
}

<div class="relative bg-gradient-to-b from-white via-blue-50/60 to-white py-16 md:py-24 -mt-6">
    <div class="absolute inset-0 opacity-5 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>

    <div class="container mx-auto max-w-5xl px-4 relative z-10 text-center">


        <h1 class="text-3xl md:text-5xl leading-tight font-extrabold text-gray-900 font-display">
            Khám phá nhà hàng yêu thích
            <br />
            <span class="text-blue-600">Đặt bàn chỉ trong vài giây</span>
        </h1>



        @using (Html.BeginForm("Search", "Home", FormMethod.Get))
        {
            <div class="bg-white mt-10 p-4 rounded-2xl shadow-lg max-w-4xl mx-auto border border-gray-200 space-y-4">

                <div class="flex flex-col md:flex-row gap-3">
                    <div class="relative flex-grow">
                        <i class="fas fa-search absolute left-4 top-1/2"
                           style="
                               transform: translateY(-50%);
                               font-size: 14px;
                               color: #4b5563 !important; 
                           ">
                        </i>                        
                        <input name="SearchKeyword" value="@Model.SearchKeyword"
                               placeholder="Nhập tên nhà hàng, món ăn..."
                               class="w-full pl-10 pr-4 py-3 rounded-xl bg-gray-50 border border-gray-200 text-sm text-gray-800 focus:ring-blue-200 focus:border-blue-400 outline-none" />
                    </div>

                    <div class="flex items-stretch">
                        <button class="w-full md:w-auto px-8 py-3 rounded-xl bg-blue-600 text-white font-semibold shadow-md hover:bg-blue-700 active:scale-95 transition">
                            Tìm kiếm
                        </button>
                    </div>
                </div>

                <div class="flex flex-wrap gap-3 text-sm items-end">

                    <div class="w-full sm:w-[48%] md:w-auto md:min-w-[160px]">
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Thành phố</label>
                        <select name="City"
                                class="w-full px-3 py-2 rounded-lg bg-gray-50 border border-gray-200 text-sm text-gray-800 focus:ring-blue-200 focus:border-blue-400 outline-none">
                            <option value="">Tất cả</option>
                            @if (ViewBag.AvailableCities != null)
                            {
                                foreach (var city in (List<string>)ViewBag.AvailableCities)
                                {
                                    <option value="@city" @(Model.City == city ? "selected" : "")>@city</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="w-full sm:w-[48%] md:w-auto md:min-w-[160px]">
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Khu vực</label>
                        <input name="Area"
                               value="@Model.Area"
                               placeholder="VD: Quận 1, Quận 3..."
                               class="w-full px-3 py-2 rounded-lg bg-gray-50 border border-gray-200 text-sm text-gray-800 focus:ring-blue-200 focus:border-blue-400 outline-none" />
                    </div>

                    <div class="w-full sm:w-[48%] md:w-auto md:min-w-[150px]">
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Loại hình</label>
                        <select name="RestaurantType"
                                class="w-full px-3 py-2 rounded-lg bg-gray-50 border border-gray-200 text-sm text-gray-800 focus:ring-blue-200 focus:border-blue-400 outline-none">
                            <option value="">Tất cả</option>
                            <option value="Nhà hàng" @(Model.RestaurantType == "Nhà hàng" ? "selected" : "")>Nhà hàng</option>
                            <option value="Quán nhậu" @(Model.RestaurantType == "Lẫu" ? "selected" : "")>Lẫu</option>

                            <option value="Quán nhậu" @(Model.RestaurantType == "Quán nhậu" ? "selected" : "")>Quán nhậu</option>
                            <option value="Buffet" @(Model.RestaurantType == "Buffet" ? "selected" : "")>Buffet</option>
                            <option value="Cafe" @(Model.RestaurantType == "Cafe" ? "selected" : "")>Cafe</option>

                        </select>
                    </div>

                    <div class="w-full sm:w-[48%] md:w-auto md:min-w-[150px]">
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Giá trung bình</label>
                        <select name="AveragePrice"
                                class="w-full px-3 py-2 rounded-lg bg-gray-50 border border-gray-200 text-sm text-gray-800 focus:ring-blue-200 focus:border-blue-400 outline-none">
                            <option value="">Tất cả</option>
                            <option value="Dưới 150K" @(Model.AveragePrice == "Dưới 150K" ? "selected" : "")>Dưới 150K</option>
                            <option value="150K - 250K" @(Model.AveragePrice == "150K - 250K" ? "selected" : "")>150K - 250K</option>
                            <option value="250K - 500K" @(Model.AveragePrice == "250K - 500K" ? "selected" : "")>250K - 500K</option>
                            <option value="500K - 1.000K" @(Model.AveragePrice == "500K - 1.000K" ? "selected" : "")>500K - 1.000K</option>
                            <option value="> 1.000K" @(Model.AveragePrice == "> 1.000K" ? "selected" : "")>> 1.000K</option>
                        </select>
                    </div>



                </div>
            </div>
        }


    </div>
</div>


<div class="container mx-auto max-w-7xl px-4 py-12">

    
    <div class="mb-8">
        <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <span class="w-1 h-6 bg-blue-600 rounded-full"></span>
            Gợi ý cho bạn
        </h2>
        <p class="text-gray-500 text-sm mt-1 ml-3">
            @(Model.Results?.Count ?? 0) nhà hàng phù hợp
        </p>
    </div>

    @if (Model.Results == null || !Model.Results.Any())
    {
        <div class="bg-gray-50 py-20 rounded-3xl border border-gray-200 flex flex-col items-center">
            <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center shadow text-gray-300 mb-5">
                <i class="fas fa-search text-3xl"></i>
            </div>
            <p class="text-gray-600 font-medium text-lg">Không tìm thấy kết quả nào</p>
            <a href="@Url.Action("Index")"
               class="mt-3 px-6 py-2 bg-blue-600 text-white rounded-lg">
                Xóa bộ lọc
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
            @foreach (var item in Model.Results)
            {
                var approvedReviews = (item.Reviews ?? new List<Reviews>())
                    .Where(r => r.status == "approved" || r.status == null)
                    .ToList();

                var reviewCount = approvedReviews.Count;
                double avgRating = reviewCount > 0 ? approvedReviews.Average(r => (double)r.rating) : 0;
                string avgRatingStr = avgRating > 0 ? avgRating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) : "0.0";

                <a href="@Url.Action("RestaurantDetails", "Home", new { id = item.restaurant_id })"
                   class="group bg-white border border-gray-100 rounded-2xl shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all overflow-hidden flex flex-col">

                    <div class="relative h-52 overflow-hidden">
                        <img src="@(item.Image ?? "https://via.placeholder.com/500")"
                             alt="@item.name"
                             class="w-full h-full object-cover group-hover:scale-105 duration-700 ease-out" />

                        @if (reviewCount > 0)
                        {
                            <div class="absolute top-3 right-3 bg-white/95 backdrop-blur-sm px-3 py-1.5 rounded-full shadow-md flex items-center gap-1.5">
                                <i class="fas fa-star review-star-color"></i>                                <span class="font-bold text-amber-500 text-sm">@avgRatingStr</span>
                                <span class="text-xs text-gray-500">(@reviewCount)</span>
                            </div>
                        }
                    </div>
                    <style>

                        .review-star-color {
                            color: #f59e0b !important;
                        }
                    </style>
                    <div class="p-4 flex flex-col gap-2 flex-1">

                        <div>
                            <h3 class="text-base md:text-lg font-bold text-gray-900 group-hover:text-blue-600 line-clamp-1">
                                @item.name
                            </h3>
                            <p class="mt-1 text-xs md:text-sm text-gray-500 line-clamp-1">
                                @item.address
                            </p>
                        </div>

                        @if (!string.IsNullOrEmpty(item.opening_hours))
                        {
                            <p class="mt-0.5 text-xs text-gray-500 line-clamp-1">
                                <span class="font-semibold text-gray-600">Giờ mở cửa:</span>
                                @item.opening_hours
                            </p>
                        }

                        @if (!string.IsNullOrEmpty(item.CuisineStyle))
                        {
                            <p class="mt-0.5 text-xs text-gray-500 line-clamp-1">
                                <span class="font-semibold text-gray-600">Loại hình:</span>
                                @item.CuisineStyle
                            </p>
                        }

                        <div style="margin-top:8px; display:flex; align-items:center; gap:8px;">
                            <div style="display:flex; gap:2px;">
                                @{
                                    int ratingValue = (int)Math.Round(avgRating);

                                    for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= ratingValue)
                                        {
                                            <i class="fas fa-star"
                                               style="font-size:12px; color:#facc15 !important; fill:#facc15 !important;"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-star"
                                               style="font-size:12px; color:#d1d5db !important; fill:#d1d5db !important;"></i>
                                        }
                                    }
                                }
                            </div>

                            @if (reviewCount == 0)
                            {
                                <span style="font-size:12px; color:#9ca3af;">Chưa có đánh giá</span>
                            }
                            else
                            {
                                <span style="font-size:12px; color:#4b5563;">
                                    @reviewCount đánh giá
                                </span>
                            }
                        </div>




                        <div class="mt-3 pt-3 border-t border-gray-100 flex items-center justify-between">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-green-50 text-[11px] md:text-xs text-green-700 font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-1.5"></span>
                                Đang mở
                            </span>

                            <span class="text-sm md:text-base font-semibold text-blue-600 inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                                Xem chi tiết
                                <span>→</span>
                            </span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>
