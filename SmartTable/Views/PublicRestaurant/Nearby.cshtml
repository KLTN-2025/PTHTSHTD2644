@{
    ViewBag.Title = "Nhà hàng gần bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container mx-auto p-6 lg:py-10">
    <h1 class="text-3xl font-bold mb-2 text-gray-800">
        <i class="fas fa-location-dot text-red-600 mr-2"></i> Khám phá Nhà hàng Gần Bạn
    </h1>
    <p class="text-gray-600 mb-6 italic text-sm">
        <i class="fas fa-info-circle mr-1"></i> Nếu vị trí chưa chính xác, bạn có thể <b>kéo thả biểu tượng màu xanh</b> đến vị trí đúng của mình.
    </p>

    <div class="flex flex-col lg:flex-row gap-6">

        <div class="lg:w-3/5 bg-white p-4 rounded-xl shadow-2xl border-l-4 border-blue-600">
            <div class="flex justify-between items-center mb-3 border-b pb-2">
                <h2 class="text-xl font-semibold text-blue-600">Bản đồ (Bán kính 5km)</h2>
                <button onclick="locateUser()" class="text-sm bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-400 transition">
                    <i class="fas fa-crosshairs"></i> Tìm lại tôi
                </button>
            </div>
            <div id="map-container" style="height: 500px; border-radius: 8px; z-index: 0;">
                <p class="text-center text-gray-500 pt-20">Đang lấy vị trí...</p>
            </div>
        </div>

        <div class="lg:w-2/5 bg-white p-4 rounded-xl shadow-2xl border-l-4 border-red-600">
            <h2 class="text-xl font-semibold mb-3 border-b pb-2 text-red-600">Danh sách Gần nhất</h2>
            <div id="restaurant-list-container" class="space-y-4 overflow-y-auto pr-2" style="max-height: 500px;">
                <p class="text-center text-gray-500">Đang chờ vị trí...</p>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        var map;
        var userMarker; 
        var searchCircle;
        var restaurantMarkers = []; 
        const DEFAULT_POS = [10.8231, 106.6297]; // TP.HCM

        // Icon Nhà hàng
        const RestaurantIcon = L.icon({
            iconUrl: 'https://cdn-icons-png.flaticon.com/512/3448/3448373.png',
            iconSize: [32, 32], iconAnchor: [16, 32], popupAnchor: [0, -32]
        });

        // Icon Người dùng (Màu xanh)
        const UserIcon = L.icon({
            iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-blue.png',
            shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
            iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34], shadowSize: [41, 41]
        });

        document.addEventListener('DOMContentLoaded', function () {
            locateUser(); // Tự động tìm khi vào trang
        });

        function locateUser() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (pos) => initMap(pos.coords.latitude, pos.coords.longitude),
                    () => initMap(DEFAULT_POS[0], DEFAULT_POS[1]), // Fallback nếu lỗi
                    { enableHighAccuracy: true, timeout: 10000 }
                );
            } else {
                initMap(DEFAULT_POS[0], DEFAULT_POS[1]);
            }
        }

        function initMap(lat, lng) {
            const userLocation = [lat, lng];

            // 1. Khởi tạo bản đồ (nếu chưa có)
            if (!map) {
                map = L.map('map-container').setView(userLocation, 14);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap'
                }).addTo(map);
            } else {
                map.setView(userLocation, 14);
            }

            // 2. Xử lý Marker Người dùng (Cho phép Kéo thả)
            if (userMarker) map.removeLayer(userMarker);
            if (searchCircle) map.removeLayer(searchCircle);

            // Vẽ vòng tròn 5km
            searchCircle = L.circle(userLocation, {
                color: 'blue', fillColor: '#3b82f6', fillOpacity: 0.1, radius: 5000
            }).addTo(map);

            // Vẽ Marker
            userMarker = L.marker(userLocation, {
                icon: UserIcon,
                draggable: true // <--- QUAN TRỌNG: Cho phép kéo
            }).addTo(map)
            .bindPopup("<b>Bạn đang ở đây</b><br>Kéo tôi để chỉnh vị trí!").openPopup();

            // 3. Sự kiện khi Kéo thả xong -> Tìm lại nhà hàng
            userMarker.on('dragend', function(event) {
                var marker = event.target;
                var position = marker.getLatLng();

                searchCircle.setLatLng(position);
                map.panTo(position); 

                loadNearbyRestaurants(position.lat, position.lng);
            });

            // 4. Tải dữ liệu lần đầu
            loadNearbyRestaurants(lat, lng);
        }

        function loadNearbyRestaurants(lat, lng) {
            const url = '@Url.Action("GetNearbyMapData", "PublicRestaurant")';
            const $listContainer = $('#restaurant-list-container');

            $listContainer.html('<div class="text-center py-4"><i class="fas fa-spinner fa-spin text-blue-600 text-2xl"></i><p class="text-gray-500 mt-2">Đang quét nhà hàng...</p></div>');

            // Xóa các marker nhà hàng cũ
            restaurantMarkers.forEach(m => map.removeLayer(m));
            restaurantMarkers = [];

            $.ajax({
                url: url,
                type: 'GET',
                data: { lat: lat, lng: lng, radiusKm: 5 },
                dataType: 'json',
                success: function (data) {
                    let listHtml = '';

                    if (data.length === 0) {
                        listHtml = '<div class="text-center p-6 bg-gray-50 rounded-lg"><p class="text-gray-500">Không tìm thấy nhà hàng nào trong bán kính 5km.</p></div>';
                    }

                    data.forEach(function (restaurant) {
                        if (restaurant.latitude && restaurant.longitude) {

                            const detailsUrl = '@Url.Action("Details", "PublicRestaurant")' + '/' + restaurant.restaurant_id;

                            // 1. Marker trên Map
                            var marker = L.marker([restaurant.latitude, restaurant.longitude], {
                                icon: RestaurantIcon
                            }).addTo(map)
                            .bindPopup(`
                                <div class="text-center">
                                    <h5 style="font-weight:bold; margin-bottom:2px; color:#1e40af;">${restaurant.name}</h5>
                                    <p style="font-size:11px; color:#666;">${restaurant.distanceKm.toFixed(1)} km</p>
                                    <a href="/Home/RestaurantDetails/${restaurant.restaurant_id}" class="text-blue-600 underline text-xs">Xem chi tiết</a>
                                </div>
                            `);
                            restaurantMarkers.push(marker);

                            // 2. Item trong Danh sách
                            listHtml += `
                            <a href="/Home/RestaurantDetails/${restaurant.restaurant_id}" class="block group">
                                <div class="flex items-start space-x-3 border border-gray-200 p-3 rounded-lg bg-white hover:shadow-lg hover:border-blue-300 transition duration-200">
                                    <img src="${restaurant.Image || '/Content/placeholder.png'}" class="w-20 h-20 object-cover rounded-md flex-shrink-0 group-hover:opacity-90" />
                                    <div class="flex-grow min-w-0">
                                        <div class="flex justify-between items-start">
                                            <h4 class="text-md font-bold text-gray-900 truncate group-hover:text-blue-600 transition">${restaurant.name}</h4>
                                            <span class="bg-green-100 text-green-800 text-xs font-semibold px-2 py-0.5 rounded whitespace-nowrap ml-2">${restaurant.distanceKm.toFixed(1)} km</span>
                                        </div>
                                        <p class="text-xs text-gray-500 truncate mt-1"><i class="fas fa-map-marker-alt mr-1"></i>${restaurant.address}</p>
                                        <div class="mt-2 text-right">
                                            <span class="text-blue-500 text-xs font-medium group-hover:underline">Đặt bàn ngay &rarr;</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        `;
                        }
                    });

                    $listContainer.html(listHtml);
                },
                error: function (error) {
                    $listContainer.html('<p class="text-center text-red-600">Lỗi kết nối server.</p>');
                }
            });
        }
    </script>
}