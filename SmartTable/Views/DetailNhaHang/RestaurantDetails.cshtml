@using System.Globalization
@using System.Linq
@using SmartTable.Models
@model SmartTable.Models.ViewModels.SmartTableDetailViewModel
@{
    ViewBag.Title = Model.Restaurant.name;
    Layout = "~/Views/Shared/_Layout.cshtml";

    @helper DetailRow(string iconClass, string label, object value)
    {
        string val = (value == null || string.IsNullOrWhiteSpace(value.ToString()))
            ? "Đang cập nhật"
            : value.ToString();

        <div class="flex items-start py-4 px-3 bg-gradient-to-r from-gray-50 to-white
                rounded-xl border border-gray-100 hover:border-red-200 hover:shadow-sm
                transition-all duration-200">
            <div class="w-10 h-10 flex-shrink-0 rounded-lg
                    bg-gradient-to-br from-red-400 to-red-600
                    flex items-center justify-center mr-4 shadow-sm">
                <i class="@iconClass text-white text-lg"></i>
            </div>

            <div class="flex-grow">
                <span class="text-xs font-semibold text-gray-600 uppercase tracking-wider block mb-1">
                    @label
                </span>
                <span class="text-base text-gray-900 font-medium">
                    @val
                </span>
            </div>
        </div>
    }

    var approvedReviews = (Model.Reviews ?? new List<Reviews>())
        .Where(x => x.status == "approved" || x.status == null)
        .ToList();

    var reviewCount = approvedReviews.Count;
    double avgRating = reviewCount > 0 ? approvedReviews.Average(r => (double)r.rating) : 0;
    string avgRatingStr = avgRating > 0 ? avgRating.ToString("0.0", CultureInfo.InvariantCulture) : "0.0";
}

<style>
    .restaurant-page i,
    .restaurant-page svg {
        opacity: 1 !important;
        filter: none !important;
    }

    .restaurant-page .nav-pill.active {
        color: #dc2626;
        border-bottom-color: #dc2626;
    }

    .rating-star {
        transition: all 0.2s ease;
    }

    .star-btn {
        transition: all 0.2s ease;
    }

        .star-btn:hover {
            transform: scale(1.1);
        }

    .menu-filter {
        padding: 0.5rem 1rem;
        border-radius: 999px;
        border: 1px solid #e5e7eb;
        font-size: 0.875rem;
        font-weight: 500;
        color: #4b5563;
        background: #f9fafb;
        cursor: pointer;
        transition: all .2s;
        white-space: nowrap;
    }

        .menu-filter:hover {
            background: #fee2e2;
            border-color: #fecaca;
            color: #b91c1c;
        }

        .menu-filter.active {
            background: #dc2626;
            border-color: #dc2626;
            color: #fff;
        }
</style>

<div class="restaurant-page min-h-screen bg-gradient-to-b from-gray-50 to-white">
    <!-- HERO -->
    <div class="relative bg-gradient-to-br from-gray-900 to-gray-800 text-white overflow-hidden">
        <div class="absolute inset-0 group cursor-pointer" onclick="openHeroImage()">
            <div class="absolute inset-0"
                 style="background-image: url('@(Model.Restaurant.Image ?? "https://via.placeholder.com/1920x600")'); background-size: cover; background-position: center;">
            </div>
            <div class="absolute inset-0 bg-black/60 group-hover:bg-black/40 transition"></div>
        </div>

        <div class="container mx-auto px-4 lg:px-8 py-12 lg:py-16 relative z-10">
            <div class="max-w-4xl">
                <div class="flex items-center gap-2 text-sm text-gray-300 mb-4">
                    <a href="@Url.Action("Index","Home")" class="hover:text-white transition-colors">Trang chủ</a>
                    <i class="fas fa-chevron-right text-xs text-gray-400"></i>
                    <span class="text-red-200 font-medium">@Model.Restaurant.name</span>
                </div>

                <h1 class="text-4xl lg:text-5xl font-bold mb-4 leading-tight">
                    @Model.Restaurant.name
                </h1>

                <div class="flex items-center gap-2 text-lg mb-6">
                    <i class="fas fa-map-marker-alt text-red-400"></i>
                    <span class="text-gray-100">@Model.Restaurant.address</span>
                </div>

                <div class="flex flex-wrap gap-3">
                    <div class="flex items-center gap-2 bg-white/15 rounded-full px-4 py-2 shadow-sm">
                        <i class="fas fa-star text-yellow-400"></i>
                        @if (reviewCount > 0)
                        {
                            <span class="font-semibold">@avgRatingStr</span>
                            <span class="text-gray-200 text-sm">(@reviewCount đánh giá)</span>
                        }
                        else
                        {
                            <span class="font-semibold">0.0</span>
                            <span class="text-gray-200 text-sm">(Chưa có đánh giá)</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Restaurant.opening_hours))
                    {
                        <div class="flex items-center gap-2 bg-white/15 rounded-full px-4 py-2 shadow-sm">
                            <i class="fas fa-clock text-emerald-300"></i>
                            <span class="text-gray-100">@Model.Restaurant.opening_hours</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Restaurant.CuisineStyle))
                    {
                        <div class="flex items-center gap-2 bg-white/15 rounded-full px-4 py-2 shadow-sm">
                            <i class="fas fa-utensils text-orange-300"></i>
                            <span class="text-gray-100">@Model.Restaurant.CuisineStyle</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 lg:px-8 py-8">
        <div class="flex flex-col lg:flex-row gap-8">
            <div class="lg:w-2/3 space-y-8">
                <!-- HÌNH ẢNH CHÍNH -->
                <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
                    <div class="relative">
                        <img src="@(Model.Restaurant.Image ?? "https://via.placeholder.com/1200x600")"
                             alt="Ảnh nhà hàng"
                             class="w-full h-96 object-cover hover:scale-105 transition-transform duration-700 cursor-zoom-in"
                             id="main-image" />

                        @if (Model.Restaurant.RestaurantImages != null && Model.Restaurant.RestaurantImages.Any())
                        {
                            <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 flex gap-2 bg-black/30 rounded-full px-3 py-2">
                                @foreach (var img in Model.Restaurant.RestaurantImages.Take(4))
                                {
                                    <button type="button"
                                            class="w-20 h-12 rounded-lg overflow-hidden border-2 border-white/70 shadow-lg hover:scale-110 transition-transform duration-200"
                                            onclick="changeMainImage('@img.image_url')">
                                        <img src="@img.image_url" alt="Thumbnail" class="w-full h-full object-cover" />
                                    </button>
                                }
                                @if (Model.Restaurant.RestaurantImages.Count > 4)
                                {
                                    <div class="w-20 h-12 rounded-lg bg-gray-900/80 text-white flex items-center justify-center font-semibold text-sm">
                                        +@(Model.Restaurant.RestaurantImages.Count - 4)
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- NAVIGATION -->
                <div class="sticky top-20 z-30 bg-white rounded-2xl shadow-md border border-gray-100 overflow-hidden">
                    <div class="flex overflow-x-auto scrollbar-hide">
                        <a href="#gioi-thieu" class="nav-pill flex-1 min-w-0 px-6 py-4 text-center font-semibold text-gray-700 border-b-2 border-transparent hover:text-red-600 hover:border-red-500 transition-all duration-200 flex items-center justify-center gap-2">
                            <i class="fas fa-info-circle"></i><span>Thông tin</span>
                        </a>
                        <a href="#thuc-don" class="nav-pill flex-1 min-w-0 px-6 py-4 text-center font-semibold text-gray-700 border-b-2 border-transparent hover:text-red-600 hover:border-red-500 transition-all duration-200 flex items-center justify-center gap-2">
                            <i class="fas fa-utensils"></i><span>Thực đơn</span>
                        </a>
                        <a href="#ban-do" class="nav-pill flex-1 min-w-0 px-6 py-4 text-center font-semibold text-gray-700 border-b-2 border-transparent hover:text-red-600 hover:border-red-500 transition-all duration-200 flex items-center justify-center gap-2">
                            <i class="fas fa-map-marked-alt"></i><span>Bản đồ</span>
                        </a>
                        <a href="#danh-gia" class="nav-pill flex-1 min-w-0 px-6 py-4 text-center font-semibold text-gray-700 border-b-2 border-transparent hover:text-red-600 hover:border-red-500 transition-all duration-200 flex items-center justify-center gap-2">
                            <i class="fas fa-star"></i><span>Đánh giá</span>
                            @if (reviewCount > 0)
                            {
                                <span class="bg-red-100 text-red-600 text-xs px-2 py-1 rounded-full font-semibold">@reviewCount</span>
                            }
                        </a>
                    </div>
                </div>

                <div class="space-y-10">
                    <!-- GIỚI THIỆU -->
                    <section id="gioi-thieu" class="scroll-mt-24">
                        <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8">
                            <div class="flex items-center gap-3 mb-6">
                                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-red-500 to-red-600 flex items-center justify-center">
                                    <i class="fas fa-info-circle text-white text-xl"></i>
                                </div>
                                <h2 class="text-2xl font-bold text-gray-900">Giới thiệu nhà hàng</h2>
                            </div>

                            <div class="text-gray-700 leading-relaxed">
                                @(string.IsNullOrEmpty(Model.Restaurant.description)
                                    ? "Nhà hàng hiện đang cập nhật thông tin mô tả. Quý khách vui lòng liên hệ trực tiếp để biết thêm chi tiết."
                                    : Model.Restaurant.description)
                            </div>

                            <div class="grid md:grid-cols-2 gap-6 mt-10">
                                <div class="space-y-4">
                                    <h3 class="text-xl font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200">Đặc điểm & Dịch vụ</h3>
                                    @DetailRow("fas fa-dollar-sign", "Khoảng giá", Model.Restaurant.AverageBill)
                                    @DetailRow("fas fa-concierge-bell", "Loại hình", Model.Restaurant.ServiceDescription)
                                    @DetailRow("fas fa-hands-helping", "Phục vụ", Model.Restaurant.ServiceTypes)
                                    @DetailRow("fas fa-crown", "Món đặc sắc", Model.Restaurant.SignatureDishes)
                                </div>
                                <div class="space-y-4">
                                    <h3 class="text-xl font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200">Không gian & Tiện ích</h3>
                                    @DetailRow("fas fa-chair", "Sức chứa", Model.Restaurant.max_tables.HasValue ? $"{Model.Restaurant.max_tables} bàn" : null)
                                    @DetailRow("fas fa-door-closed", "Phòng riêng", Model.Restaurant.PrivateRoomCount)
                                    @DetailRow("fas fa-couch", "Chỗ ngồi", Model.Restaurant.SeatingType)
                                    @DetailRow("fas fa-wifi", "Tiện ích", Model.Restaurant.Amenities)
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- THỰC ĐƠN -->
                    <section id="thuc-don" class="scroll-mt-24">
                        <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8">
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center">
                                    <i class="fas fa-utensils text-white text-xl"></i>
                                </div>
                                <h2 class="text-2xl font-bold text-gray-900">Thực đơn</h2>
                            </div>

                            @if (Model.MenuItems == null || !Model.MenuItems.Any())
                            {
                                <div class="text-center py-12">
                                    <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-orange-100 flex items-center justify-center">
                                        <i class="fas fa-utensils text-3xl text-orange-400"></i>
                                    </div>
                                    <h3 class="text-lg font-semibold text-gray-700 mb-2">Menu đang được cập nhật</h3>
                                    <p class="text-gray-500">Nhà hàng đang hoàn thiện thực đơn, vui lòng quay lại sau.</p>
                                </div>
                            }
                            else
                            {
                                <div class="flex flex-wrap gap-2 mb-6">
                                    <button type="button" class="menu-filter active" data-category="all">Tất cả</button>
                                    <button type="button" class="menu-filter" data-category="Món khai vị">Món khai vị</button>
                                    <button type="button" class="menu-filter" data-category="Món chính">Món chính</button>
                                    <button type="button" class="menu-filter" data-category="Tráng miệng">Tráng miệng</button>
                                    <button type="button" class="menu-filter" data-category="Đồ uống">Đồ uống</button>
                                </div>

                                <div class="grid md:grid-cols-2 gap-6" id="menu-list">
                                    @foreach (var item in Model.MenuItems.OrderBy(m => m.name))
                                    {
                                        var lowerName = (item.name ?? "").ToLowerInvariant();
                                        string cat;
                                        if (lowerName.Contains("khai vị") || lowerName.Contains("salad") || lowerName.Contains("gỏi"))
                                        {
                                            cat = "Món khai vị";
                                        }
                                        else if (lowerName.Contains("lẩu") || lowerName.Contains("cơm") || lowerName.Contains("mì")
                                              || lowerName.Contains("phở") || lowerName.Contains("bún")
                                              || lowerName.Contains("steak") || lowerName.Contains("main"))
                                        {
                                            cat = "Món chính";
                                        }
                                        else if (lowerName.Contains("tráng miệng") || lowerName.Contains("dessert")
                                              || lowerName.Contains("chè") || lowerName.Contains("kem"))
                                        {
                                            cat = "Tráng miệng";
                                        }
                                        else if (lowerName.Contains("nước") || lowerName.Contains("cafe") || lowerName.Contains("cà phê")
                                              || lowerName.Contains("soda") || lowerName.Contains("trà")
                                              || lowerName.Contains("juice") || lowerName.Contains("bia") || lowerName.Contains("wine"))
                                        {
                                            cat = "Đồ uống";
                                        }
                                        else
                                        {
                                            cat = "Món chính";
                                        }

                                        <div class="menu-item-card group bg-gradient-to-br from-gray-50 to-white rounded-xl border border-gray-100 p-5 hover:shadow-xl hover:border-red-200 transition-all duration-300"
                                             data-category="@cat">
                                            <div class="flex gap-4">
                                                <div class="flex-shrink-0">
                                                    <div class="w-24 h-24 rounded-xl overflow-hidden shadow-md">
                                                        @if (!string.IsNullOrEmpty(item.Image))
                                                        {
                                                            <img src="@item.Image" alt="@item.name"
                                                                 class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                                                        }
                                                        else
                                                        {
                                                            <div class="w-full h-full bg-gradient-to-br from-orange-100 to-red-100 flex items-center justify-center">
                                                                <i class="fas fa-utensils text-2xl text-orange-400"></i>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="flex-grow">
                                                    <div class="flex items-center justify-between mb-1">
                                                        <h4 class="font-bold text-gray-900 text-lg">@item.name</h4>
                                                        <span class="text-xs px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 font-semibold">
                                                            @cat
                                                        </span>
                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(item.description))
                                                    {
                                                        <p class="text-sm text-gray-600 whitespace-pre-wrap mb-2">@item.description</p>
                                                    }

                                                    <div class="text-xl font-bold text-red-600">
                                                        @item.price.ToString("N0") đ
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </section>

                    <!-- BẢN ĐỒ -->
                    <section id="ban-do" class="scroll-mt-24">
                        <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8">
                            <div class="flex items-center gap-3 mb-6">
                                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center">
                                    <i class="fas fa-map-marked-alt text-white text-xl"></i>
                                </div>
                                <h2 class="text-2xl font-bold text-gray-900">Vị trí nhà hàng</h2>
                            </div>

                            @if (Model.Restaurant.latitude.HasValue && Model.Restaurant.longitude.HasValue
                                && (Model.Restaurant.latitude.Value != 0 || Model.Restaurant.longitude.Value != 0))
                            {
                                var latStr = Model.Restaurant.latitude.Value.ToString(CultureInfo.InvariantCulture);
                                var lngStr = Model.Restaurant.longitude.Value.ToString(CultureInfo.InvariantCulture);

                                <div class="rounded-xl overflow-hidden shadow-lg mb-4">
                                    <iframe width="100%"
                                            height="380"
                                            style="border:0;"
                                            loading="lazy"
                                            referrerpolicy="no-referrer-when-downgrade"
                                            src="https://www.openstreetmap.org/export/embed.html?bbox=@(lngStr),@(latStr),@(lngStr),@(latStr)&layer=mapnik&marker=@(latStr),@(lngStr)">
                                    </iframe>
                                </div>
                            }
                            else
                            {
                                <div class="h-96 w-full rounded-xl overflow-hidden shadow-lg mb-4 bg-gray-100 flex items-center justify-center text-gray-500">
                                    Bản đồ sẽ hiển thị khi nhà hàng cập nhật tọa độ.
                                </div>
                            }

                            <div class="flex items-center gap-3 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl p-4">
                                <i class="fas fa-map-marker-alt text-2xl text-red-500"></i>
                                <div>
                                    <p class="font-semibold text-gray-900">Địa chỉ</p>
                                    <p class="text-gray-700">@Model.Restaurant.address</p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- ĐÁNH GIÁ -->
                    <section id="danh-gia" class="scroll-mt-24">
                        <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8">
                            <div class="flex items-center justify-between mb-8">
                                <div class="flex items-center gap-3">
                                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-yellow-500 to-yellow-600 flex items-center justify-center">
                                        <i class="fas fa-star text-white text-xl"></i>
                                    </div>
                                    <h2 class="text-2xl font-bold text-gray-900">Đánh giá từ khách hàng</h2>
                                </div>
                                <div class="text-right">
                                    <div class="text-3xl font-bold text-gray-900">
                                        @avgRatingStr <span class="text-yellow-500"><i class="fas fa-star ml-1"></i></span>
                                    </div>
                                    <p class="text-sm text-gray-500">@reviewCount đánh giá</p>
                                </div>
                            </div>

                            @if (Model.Reviews == null || !Model.Reviews.Any(r => r.status == "approved" || r.status == null))
                            {
                                <div class="text-center py-12">
                                    <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-yellow-100 flex items-center justify-center">
                                        <i class="fas fa-star text-3xl text-yellow-500"></i>
                                    </div>
                                    <h3 class="text-lg font-semibold text-gray-700 mb-2">Chưa có đánh giá nào</h3>
                                    <p class="text-gray-500">Hãy là người đầu tiên chia sẻ trải nghiệm của bạn.</p>
                                </div>
                            }
                            else
                            {
                                <div class="space-y-6 mb-8">
                                    @foreach (var r in approvedReviews.OrderByDescending(x => x.created_at).Take(10))
                                    {
                                        <div class="bg-white rounded-xl border border-gray-200 p-6 hover:shadow-md transition-shadow duration-300">
                                            <div class="flex flex-col sm:flex-row sm:items-start justify-between mb-4 gap-4">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-red-100 to-red-200 flex items-center justify-center font-semibold text-red-600 text-lg">
                                                        @if (!string.IsNullOrEmpty(r.Users?.full_name))
                                                        {
                                                            @r.Users.full_name.Substring(0, 1).ToUpper()
                                                        }
                                                        else
                                                        {
                                                            @:K
                                                        }
                                                    </div>
                                                    <div>
                                                        <p class="font-semibold text-gray-900">@(r.Users?.full_name ?? "Khách ẩn danh")</p>
                                                        <p class="text-sm text-gray-500">
                                                            @if (r.created_at.HasValue)
                                                            {
                                                                @r.created_at.Value.ToString("dd/MM/yyyy HH:mm")
                                                            }
                                                        </p>
                                                    </div>
                                                </div>

                                                <div class="flex items-center gap-2">
                                                    <div class="flex gap-1">
                                                        @{
                                                            int ratingValue = (r.rating >= 1 && r.rating <= 5) ? (int)r.rating : 0;
                                                        }
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <i class="fas fa-star text-lg @(i <= ratingValue ? "text-yellow-500" : "text-gray-300")"></i>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <p class="text-gray-700 mb-4">@(r.comment ?? "")</p>

                                            @if (r.ReviewReplies != null && r.ReviewReplies.Any())
                                            {
                                                var reply = r.ReviewReplies.FirstOrDefault();
                                                if (reply != null)
                                                {
                                                    <div class="bg-blue-50 border-l-4 border-blue-500 p-4 rounded mt-4">
                                                        <p class="text-xs font-bold text-blue-600 mb-2">
                                                            <i class="fas fa-reply mr-2"></i>Phản hồi từ nhà hàng
                                                        </p>
                                                        <p class="text-sm text-gray-800">@reply.reply_text</p>
                                                        <p class="text-xs text-gray-500 mt-2">
                                                            @if (reply.created_at != null)
                                                            {
                                                                @reply.created_at.ToString("dd/MM/yyyy HH:mm")
                                                            }
                                                        </p>
                                                    </div>
                                                }
                                            }

                                            <div class="flex justify-end mt-4">
                                                <button type="button" onclick="openReportModal('@r.review_id')"
                                                        class="text-xs text-red-500 hover:text-red-700 font-medium transition-colors">
                                                    <i class="fas fa-flag mr-1"></i>Báo cáo
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="bg-gradient-to-br from-gray-50 to-white rounded-xl border border-gray-200 p-6">
                                <h3 class="text-xl font-bold text-gray-900 mb-6">Chia sẻ trải nghiệm của bạn</h3>

                                @using (Html.BeginForm("PostReview", "DetailNhaHang", FormMethod.Post, new { @class = "space-y-4" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("restaurant_id", Model.Restaurant.restaurant_id)

                                    <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-3">Đánh giá của bạn <span class="text-red-500">*</span></label>
                                        <div class="flex gap-2" id="rating-stars-container">
                                            @{
                                                int newReviewInitialRating = 5;
                                            }
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <button type="button"
                                                        class="star-btn w-14 h-14 rounded-full border-2 transition-all @(i <= newReviewInitialRating ? "bg-yellow-500 border-yellow-500" : "bg-gray-100 border-gray-300")"
                                                        data-rating-value="@i"
                                                        onclick="setRating(@i); return false;">
                                                    <i class="fas fa-star text-2xl @(i <= newReviewInitialRating ? "text-white" : "text-gray-300")"></i>
                                                </button>
                                            }
                                        </div>
                                        <input type="hidden" name="rating" id="rating-value" value="@newReviewInitialRating" />
                                    </div>

                                    <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">Nhận xét</label>
                                        <textarea name="comment"
                                                  rows="4"
                                                  class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all outline-none"
                                                  placeholder="Chia sẻ chi tiết trải nghiệm của bạn tại nhà hàng..."
                                                  required></textarea>
                                    </div>

                                    <div class="flex justify-end">
                                        <button type="submit"
                                                class="px-8 py-3 bg-gradient-to-r from-red-600 to-red-700 text-white font-bold rounded-xl hover:shadow-xl hover:from-red-700 hover:to-red-800 transition-all duration-300">
                                            <i class="fas fa-paper-plane mr-2"></i>Gửi đánh giá
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </section>
                </div>
            </div>

            <!-- BOOKING SIDEBAR -->
            <div class="lg:w-1/3">
                <div class="sticky top-24 space-y-6">
                    <!-- ĐẶT BÀN -->
                    <div class="bg-gradient-to-br from-cyan-900 to-blue-500 rounded-2xl shadow-2xl overflow-hidden">
                        <div class="p-6 text-white">
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-12 h-12 rounded-xl bg-white/20 backdrop-blur-sm flex items-center justify-center">
                                    <i class="fas fa-calendar-check text-2xl"></i>
                                </div>
                                <div>
                                    <h3 class="text-2xl font-bold">Đặt bàn ngay</h3>
                                    <p class="text-red-100 text-sm">Miễn phí • Xác nhận tức thì</p>
                                </div>
                            </div>

                            @using (Html.BeginForm("DatBan", "DatBan", FormMethod.Get, new { @class = "space-y-4" }))
                            {
                                @Html.Hidden("id", Model.Restaurant.restaurant_id)

                                <div>
                                    <label class="block text-white font-semibold mb-2 text-sm">
                                        <i class="fas fa-users mr-2"></i>Số khách
                                    </label>
                                    <input type="number" name="NumberOfPeople" min="1" max="20" value="2"
                                           class="w-full px-4 py-3 bg-white/10 backdrop-blur-sm border border-white/30 rounded-xl text-white placeholder-white/60 focus:outline-none focus:ring-2 focus:ring-white focus:border-transparent">
                                </div>

                                <div>
                                    <label class="block text-white font-semibold mb-2 text-sm">
                                        <i class="fas fa-calendar-day mr-2"></i>Ngày đến
                                    </label>
                                    <input type="date" name="ReservationDate" required
                                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                           min="@DateTime.Now.ToString("yyyy-MM-dd")"
                                           max="@DateTime.Now.AddMonths(3).ToString("yyyy-MM-dd")"
                                           class="w-full px-4 py-3 bg-white/10 backdrop-blur-sm border border-white/30 rounded-xl text-white placeholder-white/60 focus:outline-none focus:ring-2 focus:ring-white focus:border-transparent">
                                </div>

                                <div>
                                    <label class="block text-white font-semibold mb-2 text-sm">
                                        <i class="fas fa-clock mr-2"></i>Giờ đến
                                    </label>
                                    <input type="time" name="ReservationTime" value="19:00"
                                           class="w-full px-4 py-3 bg-white/10 backdrop-blur-sm border border-white/30 rounded-xl text-white placeholder-white/60 focus:outline-none focus:ring-2 focus:ring-white focus:border-transparent">
                                </div>

                                <button type="submit"
                                        class="w-full px-6 py-4 bg-red-500 text-white font-bold text-lg rounded-xl shadow-xl hover:bg-red-600 hover:shadow-2xl transform hover:-translate-y-0.5 active:scale-95 active:shadow-inner transition-all duration-200">
                                    <i class="fas fa-check-circle mr-2"></i>ĐẶT BÀN NGAY
                                </button>
                            }
                        </div>
                    </div>

                    @{
                        var hotline = (Model?.Restaurant?.ContactPhone ?? "").Trim();
                        var website = (Model?.Restaurant?.Website ?? "").Trim();

                        // Restaurants không có Email -> để rỗng (hoặc lấy từ Users nếu có)
                        var email = "";
                        // Nếu Users có email thì mở dòng này:
                        // var email = (Model?.Restaurant?.Users?.email ?? "").Trim();
                    }

                    <!-- THÔNG TIN LIÊN HỆ -->
                    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-6">
                        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
                            <i class="fas fa-headset text-red-500"></i><span>Thông tin liên hệ</span>
                        </h3>

                        <div class="space-y-3">

                            <div class="flex items-center gap-3 p-3 bg-blue-50 rounded-xl border border-blue-200">
                                <i class="fas fa-phone text-lg"
                                   style="fill:#dc2626 !important; color:#dc2626 !important;"></i>
                                <div>
                                    <p class="text-xs text-gray-600">Hotline</p>
                                    <p class="font-semibold text-gray-900">
                                        @(string.IsNullOrWhiteSpace(hotline) ? "Đang cập nhật" : hotline)
                                    </p>
                                </div>
                            </div>

                            @*<div class="flex items-center gap-3 p-3 bg-blue-50 rounded-xl border border-blue-200">
                                <i class="fas fa-envelope text-blue-600 text-lg"></i>
                                <div>
                                    <p class="text-xs text-gray-600">Email</p>
                                    <p class="font-semibold text-gray-900">
                                        @(string.IsNullOrWhiteSpace(email) ? "Đang cập nhật" : email)
                                    </p>
                                </div>
                            </div>*@

                        <div class="flex items-center gap-3 p-3 bg-blue-50 rounded-xl border border-blue-200">
                            <i class="fas fa-globe"
                               style="color:#16a34a !important; fill:#16a34a !important;"></i>
                            <div>
                                <p class="text-xs text-gray-600">Website</p>

                                @if (string.IsNullOrWhiteSpace(website))
                                {
                                    <p class="font-semibold text-gray-900">Đang cập nhật</p>
                                }
                                else
                                {
                                    var href = website.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                                        ? website
                                        : "https://" + website;

                                    <a class="font-semibold text-gray-900 hover:underline"
                                       href="@href" target="_blank" rel="noopener">
                                        @website
                                    </a>
                                }
                            </div>
                        </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- IMAGE MODAL -->
<div id="image-modal" class="fixed inset-0 bg-black bg-opacity-90 z-50 hidden items-center justify-center">
    <button onclick="closeModal()" class="absolute top-6 right-6 text-white text-3xl hover:text-red-400">
        <i class="fas fa-times"></i>
    </button>
    <img id="modal-image" class="max-w-4xl max-h-[90vh] rounded-lg" />
</div>

<!-- REPORT MODAL -->
<div id="report-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold text-gray-900">Báo cáo đánh giá</h3>
            <button type="button" onclick="closeReportModal()" class="text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>
        <form id="report-form" onsubmit="submitReport(event)">
            <input type="hidden" id="report-review-id" value="" />
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Lý do báo cáo</label>
                <select id="report-reason" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500" required>
                    <option value="">Chọn lý do...</option>
                    <option value="spam">Spam hoặc quảng cáo</option>
                    <option value="inappropriate">Nội dung không phù hợp</option>
                    <option value="false_info">Thông tin sai sự thật</option>
                    <option value="other">Lý do khác</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Mô tả chi tiết</label>
                <textarea id="report-description" rows="3"
                          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500"
                          placeholder="Vui lòng mô tả chi tiết..."></textarea>
            </div>
            <div class="flex justify-end gap-3">
                <button type="button" onclick="closeReportModal()"
                        class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50">
                    Hủy
                </button>
                <button type="submit"
                        class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">
                    Gửi báo cáo
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function setRating(value) {
        document.getElementById('rating-value').value = value;

        const buttons = document.querySelectorAll('#rating-stars-container .star-btn');
        buttons.forEach((btn, idx) => {
            const icon = btn.querySelector('i');

            if (idx + 1 <= value) {
                btn.classList.remove('bg-gray-100', 'border-gray-300');
                btn.classList.add('bg-yellow-500', 'border-yellow-500');
                icon.classList.remove('text-gray-300');
                icon.classList.add('text-white');
            } else {
                btn.classList.remove('bg-yellow-500', 'border-yellow-500');
                btn.classList.add('bg-gray-100', 'border-gray-300');
                icon.classList.remove('text-white');
                icon.classList.add('text-gray-300');
            }
        });
    }

    function openReportModal(reviewId) {
        document.getElementById('report-review-id').value = reviewId;
        document.getElementById('report-modal').classList.remove('hidden');
    }

    function closeReportModal() {
        document.getElementById('report-modal').classList.add('hidden');
        document.getElementById('report-form').reset();
    }

    function submitReport(event) {
        event.preventDefault();
        const reviewId = document.getElementById('report-review-id').value;
        const reason = document.getElementById('report-reason').value;
        const description = document.getElementById('report-description').value;

        if (!reason) {
            alert('Vui lòng chọn lý do báo cáo');
            return;
        }

        fetch('@Url.Action("ReportReview", "DetailNhaHang")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({
                reviewId: parseInt(reviewId),
                reportType: reason,
                reportReason: description
            })
        })
        .then(response => response.json())
        .then(data => {
            alert(data.message || (data.success ? 'Báo cáo đã được gửi' : 'Có lỗi xảy ra'));
            if (data.success) closeReportModal();
        })
        .catch(error => alert('Lỗi: ' + error.message));
    }

    function changeMainImage(src) {
        document.getElementById('main-image').src = src;
    }

    function openModal(src) {
        const modal = document.getElementById('image-modal');
        const img = document.getElementById('modal-image');
        img.src = src;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        const modal = document.getElementById('image-modal');
        modal.classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    function openHeroImage() {
        const main = document.getElementById('main-image');
        openModal(main.src);
    }

    document.addEventListener('DOMContentLoaded', function () {
        setRating(5);

        document.getElementById('main-image').addEventListener('click', function () {
            openModal(this.src);
        });

        document.querySelectorAll('.restaurant-page a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                const targetId = this.getAttribute('href');
                const target = document.querySelector(targetId);
                if (target) {
                    e.preventDefault();
                    const offset = 80;
                    const top = target.getBoundingClientRect().top + window.pageYOffset - offset;
                    window.scrollTo({ top: top, behavior: 'smooth' });
                }
            });
        });

        const sections = document.querySelectorAll('.restaurant-page section[id]');
        const navLinks = document.querySelectorAll('.restaurant-page .nav-pill');

        window.addEventListener('scroll', () => {
            let current = '';
            sections.forEach(section => {
                if (window.scrollY >= section.offsetTop - 150) {
                    current = section.getAttribute('id');
                }
            });

            navLinks.forEach(link => {
                link.classList.remove('active');
                if (current && link.getAttribute('href') === `#${current}`) {
                    link.classList.add('active');
                }
            });
        });

        const filterButtons = document.querySelectorAll('.menu-filter');
        const menuCards = document.querySelectorAll('.menu-item-card');

        filterButtons.forEach(btn => {
            btn.addEventListener('click', function () {
                const cat = this.getAttribute('data-category');
                filterButtons.forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                menuCards.forEach(card => {
                    const c = card.getAttribute('data-category');
                    if (cat === 'all' || c === cat) {
                        card.classList.remove('hidden');
                    } else {
                        card.classList.add('hidden');
                    }
                });
            });
        });

        document.getElementById('report-modal').addEventListener('click', function(e) {
            if (e.target === this) closeReportModal();
        });
    });
</script>