@model IEnumerable<SmartTable.Models.ViewModels.BusinessBookingItemViewModel>

@{
    ViewBag.Title = "Quản lý đặt bàn";
    Layout = "~/Views/Shared/_BusinessLayout.cshtml";

    string statusFilter = ViewBag.StatusFilter as string ?? "";
}

<div class="bg-gray-50 min-h-screen py-8">
    <div class="container mx-auto max-w-6xl px-4">

        <!-- Header + Bộ lọc -->
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-800">
                    Quản lý đặt bàn
                </h1>
                <p class="text-sm text-gray-500 mt-1">
                    Xem & xác nhận các lượt đặt chỗ của khách tại nhà hàng.
                </p>
            </div>

            <form method="get" class="flex items-center gap-2">
                <select name="statusFilter"
                        class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm text-gray-700 bg-white">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Đã đặt" @(statusFilter == "Đã đặt" ? "selected=\"selected\"" : "")>Đã đặt</option>
                    <option value="Đã cọc thành công" @(statusFilter == "Đã cọc thành công" ? "selected=\"selected\"" : "")>Đã cọc thành công</option>
                    <option value="Đã hủy" @(statusFilter == "Đã hủy" ? "selected=\"selected\"" : "")>Đã hủy</option>
                </select>
                <button type="submit"
                        class="px-3 py-1.5 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700">
                    Lọc
                </button>
            </form>
        </div>

        <!-- Thông báo -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-4 px-4 py-3 rounded-lg bg-green-50 border border-green-200 text-green-800 text-sm flex items-center gap-2">
                <i class="fas fa-check-circle"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-800 text-sm flex items-center gap-2">
                <i class="fas fa-exclamation-triangle"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }

        <!-- Bảng danh sách đặt bàn -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <table class="min-w-full text-sm">
                <thead class="bg-gray-100 text-gray-700 uppercase text-xs">
                    <tr>
                        <th class="px-4 py-3 text-left">Mã</th>
                        <th class="px-4 py-3 text-left">Nhà hàng</th>
                        <th class="px-4 py-3 text-left">Khách hàng</th>
                        <th class="px-4 py-3 text-left">Thời gian</th>
                        <th class="px-4 py-3 text-center">Số khách</th>
                        <th class="px-4 py-3 text-left">Trạng thái đặt bàn</th>
                        <th class="px-4 py-3 text-left">Thanh toán</th>
                        <th class="px-4 py-3 text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="hover:bg-gray-50">
                                <!-- Mã booking -->
                                <td class="px-4 py-3 align-top">
                                    <span class="font-semibold text-gray-800">#@item.BookingId</span>
                                </td>

                                <!-- Thông tin nhà hàng -->
                                <td class="px-4 py-3 align-top">
                                    <div class="flex items-center gap-3">
                                        <img src="@item.RestaurantImage"
                                             class="w-12 h-12 rounded-lg object-cover border border-gray-200" />
                                        <div>
                                            <div class="font-semibold text-gray-800">@item.RestaurantName</div>
                                            @if (!string.IsNullOrEmpty(item.RestaurantAddress))
                                            {
                                                <div class="text-xs text-gray-500">
                                                    <i class="fas fa-map-marker-alt text-red-500 mr-1"></i>
                                                    @item.RestaurantAddress
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <!-- Khách hàng -->
                                <td class="px-4 py-3 align-top">
                                    <div class="font-medium text-gray-800">@item.CustomerName</div>
                                    @if (!string.IsNullOrEmpty(item.CustomerPhone))
                                    {
                                        <div class="text-xs text-gray-500">
                                            <i class="fas fa-phone-alt mr-1"></i>@item.CustomerPhone
                                        </div>
                                    }
                                </td>

                                <!-- Thời gian -->
                                <td class="px-4 py-3 align-top">
                                    <div class="text-gray-800 font-medium">
                                        @item.BookingTime.ToString("HH:mm dd/MM/yyyy")
                                    </div>
                                </td>

                                <!-- Số khách -->
                                <td class="px-4 py-3 align-top text-center">
                                    <span class="inline-flex items-center justify-center px-2 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold">
                                        @item.NumberOfGuests người
                                    </span>
                                </td>

                                <!-- Trạng thái đặt bàn -->
                                <td class="px-4 py-3 align-top">
                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold
                                        @(item.BookingStatus == "Đã cọc thành công"
                                            ? "bg-green-50 text-green-700"
                                            : item.BookingStatus == "Đã hủy"
                                                ? "bg-red-50 text-red-700"
                                                : "bg-yellow-50 text-yellow-700")">
                                        @item.BookingStatus
                                    </span>
                                    @if (!string.IsNullOrEmpty(item.SpecialRequest))
                                    {
                                        <div class="mt-1 text-xs text-gray-500">
                                            <span class="font-semibold">Ghi chú:</span> @item.SpecialRequest
                                        </div>
                                    }
                                </td>

                                <!-- Thông tin thanh toán -->
                                <td class="px-4 py-3 align-top">
                                    <div class="text-xs text-gray-500 mb-1">Trạng thái:</div>
                                    <div class="font-semibold text-gray-800">@item.PaymentStatus</div>

                                    @if (item.DepositAmount.HasValue && item.DepositAmount.Value > 0)
                                    {
                                        <div class="text-xs text-gray-500 mt-1">
                                            Cọc: @item.DepositAmount.Value.ToString("#,##0") đ
                                        </div>
                                    }
                                </td>

                                <!-- Thao tác -->
                                <td class="px-4 py-3 align-top text-center">
                                    @if (!string.Equals(item.PaymentStatus, "Đã thanh toán (doanh nghiệp xác nhận)", StringComparison.OrdinalIgnoreCase)
                                         && !string.Equals(item.BookingStatus, "Đã hủy", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form action="@Url.Action("ConfirmPayment", "BusinessHome")"
                                              method="post"
                                              class="inline-block">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@item.BookingId" />

                                            <button type="submit"
                                                    class="px-3 py-2 bg-green-600 text-white text-xs font-semibold rounded-lg hover:bg-green-700 shadow-sm">
                                                Xác nhận đã nhận tiền
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-gray-400 italic">
                                            @item.PaymentStatus
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="px-4 py-6 text-center text-gray-500 text-sm">
                                Chưa có đặt bàn nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>
