@model SmartTable.Models.ViewModels.StatisticsViewModel
@{
    ViewBag.Title = "Thống kê đặt bàn";
    Layout = "~/Views/Shared/_BusinessLayout.cshtml";

    var hasRestaurantStats = Model.RestaurantStats != null && Model.RestaurantStats.Any();
    var hasDailyStats = Model.DailyStats != null && Model.DailyStats.Any();

    var topRestaurant = hasRestaurantStats ? Model.RestaurantStats.First() : null;
}

<div class="bg-gray-50 min-h-screen py-8">
    <div class="container mx-auto max-w-6xl px-4 space-y-6">

        <!-- HEADER -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-gray-900">
                    Thống kê đặt bàn
                </h1>
                <p class="text-sm text-gray-500 mt-1">
                    Tổng quan hiệu quả đặt bàn và tiền cọc mà nhà hàng đã nhận được.
                </p>
            </div>

            <div class="flex items-center gap-2 text-xs text-gray-500">
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-white border border-gray-200">
                    <span class="w-2 h-2 rounded-full bg-blue-500"></span> Lượt đặt bàn
                </span>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-white border border-gray-200">
                    <span class="w-2 h-2 rounded-full bg-green-500"></span> Tiền cọc
                </span>
            </div>
        </div>

        <!-- TỔNG QUAN KPI -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Tổng lượt đặt -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex flex-col justify-between">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs uppercase tracking-wide text-gray-500 font-semibold">Tổng lượt đặt bàn</p>
                        <p class="mt-2 text-3xl font-bold text-gray-900">
                            @Model.TotalBookings
                        </p>
                    </div>
                    <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center">
                        <i class="fas fa-chair text-blue-500"></i>
                    </div>
                </div>
                <p class="mt-2 text-xs text-gray-500">
                    Tổng số lượt đặt được ghi nhận trên hệ thống.
                </p>
            </div>

            <!-- Tổng tiền cọc -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex flex-col justify-between">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs uppercase tracking-wide text-gray-500 font-semibold">Tổng tiền cọc đã nhận</p>
                        <p class="mt-2 text-3xl font-bold text-emerald-600">
                            @Model.TotalDeposit.ToString("#,##0") đ
                        </p>
                    </div>
                    <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center">
                        <i class="fas fa-donate text-emerald-500"></i>
                    </div>
                </div>
                <p class="mt-2 text-xs text-gray-500">
                    Tính cả cọc xác nhận thủ công và thanh toán qua VNPAY.
                </p>
            </div>

            <!-- Nhà hàng nổi bật -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex flex-col justify-between">
                @if (topRestaurant != null)
                {
                    <div class="flex items-start justify-between">
                        <div>
                            <p class="text-xs uppercase tracking-wide text-gray-500 font-semibold">Nhà hàng có nhiều lượt đặt nhất</p>
                            <p class="mt-2 text-base font-semibold text-gray-900">
                                @topRestaurant.RestaurantName
                            </p>
                        </div>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold">
                            <i class="fas fa-trophy mr-1"></i> Top 1
                        </span>
                    </div>
                    <div class="mt-3 flex items-center justify-between text-xs">
                        <span class="text-gray-500">
                            Lượt đặt: <span class="font-semibold text-gray-900">@topRestaurant.BookingCount</span>
                        </span>
                        <span class="text-gray-500">
                            Tiền cọc: <span class="font-semibold text-gray-900">@topRestaurant.DepositAmount.ToString("#,##0") đ</span>
                        </span>
                    </div>
                }
                else
                {
                    <div class="h-full flex flex-col items-start justify-center">
                        <p class="text-xs uppercase tracking-wide text-gray-500 font-semibold">Nhà hàng có nhiều lượt đặt nhất</p>
                        <p class="mt-2 text-sm text-gray-500">
                            Chưa có dữ liệu để xếp hạng.
                        </p>
                    </div>
                }
            </div>
        </div>

        <!-- THỐNG KÊ THEO NHÀ HÀNG -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100">
            <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
                <div>
                    <p class="font-semibold text-gray-900">Thống kê theo nhà hàng</p>
                    <p class="text-xs text-gray-500 mt-0.5">
                        Tổng hợp lượt đặt và tiền cọc theo từng nhà hàng thuộc tài khoản này.
                    </p>
                </div>
            </div>

            <table class="min-w-full text-sm">
                <thead class="bg-gray-50 text-gray-600 uppercase text-xs">
                    <tr>
                        <th class="px-4 py-3 text-left">Nhà hàng</th>
                        <th class="px-4 py-3 text-center">Số lượt đặt</th>
                        <th class="px-4 py-3 text-right">Tổng tiền cọc</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (hasRestaurantStats)
                    {
                        foreach (var r in Model.RestaurantStats)
                        {
                            var isTop = topRestaurant != null && r.RestaurantId == topRestaurant.RestaurantId;
                            <tr class="@(isTop ? "bg-amber-50/60" : "bg-white") hover:bg-gray-50 transition">
                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-2">
                                        @if (isTop)
                                        {
                                            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-500 text-white text-xs font-bold">
                                                1
                                            </span>
                                        }
                                        <span class="font-medium text-gray-900">@r.RestaurantName</span>
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <span class="inline-flex items-center justify-center px-2 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold">
                                        @r.BookingCount
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-right font-semibold text-gray-900">
                                    @r.DepositAmount.ToString("#,##0") đ
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="px-4 py-4 text-center text-gray-500 text-sm">
                                Chưa có dữ liệu đặt bàn cho bất kỳ nhà hàng nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- THỐNG KÊ THEO NGÀY -->
        @if (hasDailyStats)
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-100">
                <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
                    <div>
                        <p class="font-semibold text-gray-900">Thống kê theo ngày</p>
                        <p class="text-xs text-gray-500 mt-0.5">
                            Theo dõi xu hướng tăng/giảm lượt đặt bàn và tiền cọc theo từng ngày.
                        </p>
                    </div>
                </div>

                <table class="min-w-full text-sm">
                    <thead class="bg-gray-50 text-gray-600 uppercase text-xs">
                        <tr>
                            <th class="px-4 py-3 text-left">Ngày</th>
                            <th class="px-4 py-3 text-center">Số lượt đặt</th>
                            <th class="px-4 py-3 text-right">Tổng tiền cọc</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var d in Model.DailyStats)
                        {
                            <tr class="hover:bg-gray-50 transition">
                                <td class="px-4 py-3">
                                    <span class="font-medium text-gray-900">@d.Date.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td class="px-4 py-3 text-center">
                                    @d.BookingCount
                                </td>
                                <td class="px-4 py-3 text-right font-semibold text-gray-900">
                                    @d.DepositAmount.ToString("#,##0") đ
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>
